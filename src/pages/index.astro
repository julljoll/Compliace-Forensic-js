---
/**
 * SHA256.US — Pantalla de Acceso Oficial al Laboratorio Forense
 * Autenticación de Peritos mediante Contraseña o Google Authenticator (TOTP RFC 6238).
 */
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Pericial Oficial — SHA256.US</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/assets/uswds/css/uswds.min.css" />
    <style>
      body {
        background-color: #F0F4F8;
        font-family: 'Public Sans Web', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .login-container {
        max-width: 440px;
        width: 100%;
        margin: auto;
        background: #FFFFFF;
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(17, 46, 81, 0.08);
        padding: 32px;
      }
      .login-header {
        text-align: center;
        margin-bottom: 24px;
      }
      .login-logo {
        width: 54px;
        height: 54px;
        margin-bottom: 12px;
      }
      .tab-btn {
        flex: 1;
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid #CBD5E1;
        background: #F8FAFC;
        color: #475569;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.2s ease;
      }
      .tab-btn.active {
        background: #005EA2;
        color: #FFFFFF;
        border-color: #005EA2;
      }
    </style>
  </head>
  <body>
    <!-- Banner de Gobierno -->
    <div style="background-color: #1A2536; color: #E2E8F0; padding: 6px 16px; font-size: 12px; text-align: center; display: flex; align-items: center; justify-content: center; gap: 6px;">
      <svg class="usa-icon" aria-hidden="true" focusable="false" role="img" style="width: 14px; height: 14px; fill: currentColor;"><use xlink:href="/assets/uswds/img/sprite.svg#lock"></use></svg>
      <span><strong>SISTEMA FORENSE OFICIAL:</strong> Autenticación de Peritos y Operadores de Cadena de Custodia</span>
    </div>

    <div class="login-container">
      <div class="login-header">
        <img src="/logo.png" alt="SHA256.US" class="login-logo" />
        <h1 style="font-size: 22px; font-weight: 800; color: #112E51; margin: 0;">
          SHA256<span style="color: #D9A700;">.US</span>
        </h1>
        <p style="font-size: 13px; color: #475569; margin: 4px 0 0 0;">
          Forensic Chief Compliance Officer
        </p>
      </div>

      <!-- Selector de Método de Autenticación -->
      <div style="display: flex; gap: 8px; margin-bottom: 20px;">
        <button type="button" id="tab-pass" class="tab-btn active">
          Contraseña
        </button>
        <button type="button" id="tab-totp" class="tab-btn">
          Google Authenticator
        </button>
      </div>

      <!-- Alerta de Error (oculta por defecto) -->
      <div id="login-error-alert" class="usa-alert usa-alert--error usa-alert--slim" style="display: none; margin-bottom: 16px;">
        <div class="usa-alert__body">
          <p class="usa-alert__text" id="login-error-msg">Credenciales inválidas</p>
        </div>
      </div>

      <!-- Formulario USWDS -->
      <form class="usa-form" id="login-form" style="max-width: 100%;">
        <fieldset class="usa-fieldset">
          <legend class="usa-legend" style="font-size: 14px; font-weight: 700; color: #112E51; margin-bottom: 16px;">
            Acceso a Bóveda Pericial
          </legend>

          <label class="usa-label" for="email" style="font-size: 13px; font-weight: 600;">Correo Electrónico Oficial</label>
          <input
            class="usa-input"
            id="email"
            name="email"
            type="email"
            autocapitalize="off"
            autocorrect="off"
            required
            placeholder="perito@sha256.us"
            style="margin-bottom: 14px;"
          />

          <!-- Campo Contraseña -->
          <div id="campo-password-wrap">
            <label class="usa-label" for="password" style="font-size: 13px; font-weight: 600;">Contraseña de Seguridad</label>
            <input
              class="usa-input"
              id="password"
              name="password"
              type="password"
              placeholder="Contraseña de acceso"
              style="margin-bottom: 20px;"
            />
          </div>

          <!-- Campo Google Authenticator (TOTP) -->
          <div id="campo-totp-wrap" style="display: none;">
            <label class="usa-label" for="totp-code" style="font-size: 13px; font-weight: 600;">Código de Google Authenticator (6 dígitos)</label>
            <input
              class="usa-input"
              id="totp-code"
              name="totpCode"
              type="text"
              inputmode="numeric"
              pattern="[0-9]*"
              maxlength="6"
              placeholder="000000"
              style="font-family: 'Roboto Mono Web', Menlo, monospace; font-size: 24px; letter-spacing: 8px; text-align: center; height: 48px; margin-bottom: 14px;"
            />
            
            <div style="margin-bottom: 20px; font-size: 12px; color: #64748B; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 4px; padding: 10px;">
              <div style="font-weight: 700; color: #112E51; margin-bottom: 4px;">Configuración en Google Authenticator:</div>
              <div>Agregue la cuenta ingresando la clave secreta manual según su usuario:</div>
              <ul style="margin: 4px 0 0 0; padding-left: 18px; line-height: 1.5;">
                <li>Perito Analizador: <code style="font-weight: bold; color: #005EA2;">JULLJOLLFCCO2FA1</code></li>
                <li>Encargado Adquisición: <code style="font-weight: bold; color: #005EA2;">SHA256USFCCO2FA2</code></li>
              </ul>
            </div>
          </div>

          <button
            class="usa-button"
            type="submit"
            id="btn-submit"
            style="width: 100%; background-color: #005EA2; font-weight: 700; padding: 12px;"
          >
            Ingresar al Sistema Forense
          </button>
        </fieldset>
      </form>
    </div>

    <script>
      import { phpApi } from '../lib/data/phpApi';
      import { useAuthStore } from '../store/authStore';

      const form = document.getElementById('login-form');
      const errorAlert = document.getElementById('login-error-alert');
      const errorMsg = document.getElementById('login-error-msg');
      const btnSubmit = document.getElementById('btn-submit');

      const tabPass = document.getElementById('tab-pass');
      const tabTotp = document.getElementById('tab-totp');
      const wrapPass = document.getElementById('campo-password-wrap');
      const wrapTotp = document.getElementById('campo-totp-wrap');
      const passwordInput = document.getElementById('password') as HTMLInputElement;
      const totpInput = document.getElementById('totp-code') as HTMLInputElement;

      let authMode: 'pass' | 'totp' = 'pass';

      function setMode(mode: 'pass' | 'totp') {
        authMode = mode;
        if (mode === 'pass') {
          tabPass?.classList.add('active');
          tabTotp?.classList.remove('active');
          if (wrapPass) wrapPass.style.display = 'block';
          if (wrapTotp) wrapTotp.style.display = 'none';
          if (passwordInput) passwordInput.required = true;
          if (totpInput) totpInput.required = false;
        } else {
          tabPass?.classList.remove('active');
          tabTotp?.classList.add('active');
          if (wrapPass) wrapPass.style.display = 'none';
          if (wrapTotp) wrapTotp.style.display = 'block';
          if (passwordInput) passwordInput.required = false;
          if (totpInput) {
            totpInput.required = true;
            totpInput.focus();
          }
        }
      }

      if (tabPass) tabPass.addEventListener('click', () => setMode('pass'));
      if (tabTotp) tabTotp.addEventListener('click', () => setMode('totp'));

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const emailInput = document.getElementById('email') as HTMLInputElement;

          if (btnSubmit) btnSubmit.textContent = 'Verificando credenciales...';

          const email = (emailInput?.value || '').trim();
          const pass = authMode === 'pass' ? (passwordInput?.value || '').trim() : '';
          const totp = authMode === 'totp' ? (totpInput?.value || '').trim() : '';

          // 1. Intentar API PHP
          const res = await phpApi.login(email, pass, totp);

          if (res.ok) {
            window.location.href = '/dashboard';
            return;
          }

          // 2. Si falló por offline o error de red, probar store local
          const localOk = await useAuthStore.getState().login(email, pass, totp);
          if (localOk) {
            window.location.href = '/dashboard';
            return;
          }

          // Mostrar error
          if (errorAlert && errorMsg) {
            errorMsg.textContent = res.error || useAuthStore.getState().error || 'Credenciales no autorizadas o código 2FA erróneo';
            errorAlert.style.display = 'block';
          }
          if (btnSubmit) btnSubmit.textContent = 'Ingresar al Sistema Forense';
        });
      }
    </script>
    <script is:inline src="/assets/uswds/js/uswds.min.js"></script>
  </body>
</html>
