---
/**
 * SHA256.US — Acta de Obtención por Consignación Directa y Preservación Inicial
 * Fundamentación: MUCC-2017 & ISO/IEC 27037 · COPP Art. 187.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 2 Hojas Físicas · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <!-- ==================== HOJA 1 DE 2 ==================== -->
  <div class="page">
    <div class="watermark">OBTENCIÓN</div>

    <PlanillaHeader
      title="Acta de Obtención y Preservación Inicial de Evidencia"
      norma="MUCC-2017 · ISO/IEC 27037 §5.2–5.3 · COPP ART. 187"
      codigoDoc="FO-FOR-03"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={2}
    />

    <div class="planilla-body">
      <!-- 1.0 DATOS DE LA ACTUACIÓN -->
      <div class="section-block">
        <div class="section-heading">1.0 DATOS DE LA ACTUACIÓN FORENSE PRIVADA</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Lugar de Recepción / Sede:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual"></span> : <span>Lara, Venezuela — Sede Central Laboratorio Forense SHA256.US</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Fecha y Hora de Consignación:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual"></span> : <span>{new Date().toLocaleDateString('es-VE')} - 10:00 AM</span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 2.0 IDENTIFICACIÓN DEL CONSIGNANTE -->
      <div class="section-block">
        <div class="section-heading">2.0 IDENTIFICACIÓN COMPLETA DEL CONSIGNANTE PRIVADO</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Apellidos y Nombres:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual" data-field="solicitante_nombre"></span> : <span data-field="solicitante_nombre">{caso.solicitante_nombre}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Cédula de Identidad / RIF:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual" data-field="solicitante_cedula"></span> : <span data-field="solicitante_cedula">{caso.solicitante_cedula}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Teléfono de Contacto:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual" data-field="solicitante_telefono"></span> : <span data-field="solicitante_telefono">{caso.solicitante_telefono}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Dirección de Habitación / Sede:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual" data-field="solicitante_direccion"></span> : <span data-field="solicitante_direccion">{caso.solicitante_direccion}</span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 3.0 IDENTIFICACIÓN TÉCNICA DETALLADA DE LA EVIDENCIA DIGITAL -->
      <div class="section-block">
        <div class="section-heading">3.0 IDENTIFICACIÓN TÉCNICA DE LA EVIDENCIA DIGITAL (ISO/IEC 27037 §5.3)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Dispositivo / Medio:</th>
              <td style="width: 75%;">{isBlanco ? <span class="linea-manual"></span> : <span>{dispositivoDesc || 'Dispositivo Electrónico Digital'}</span>}</td>
            </tr>
            <tr>
              <th>Marca y Modelo:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>{dispositivoDesc || 'N/A'}</span>}</td>
            </tr>
            <tr>
              <th>Serial Físico / IMEI:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="dispositivo_imei"></span> : <span data-field="dispositivo_imei">{caso.dispositivo_imei || caso.discoduro_serial}</span>}</td>
            </tr>
            <tr>
              <th>Capacidad / Almacenamiento:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>{caso.discoduro_capacidad || 'N/A'}</span>}</td>
            </tr>
            <tr>
              <th>Estado Físico al Recibir:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Sin fracturas externas visibles, pantalla íntegra, encendido operativo.</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 4.0 OBJETO DEL ENCARGO PERICIAL -->
      <div class="section-block">
        <div class="section-heading">4.0 OBJETO Y ALCANCE DEL ENCARGO PERICIAL (COPP ART. 223)</div>
        <div class="field-value" style="font-size: 7.5pt; line-height: 1.35; min-height: 48px;">
          {isBlanco ? (
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <span class="linea-manual"></span>
              <span class="linea-manual"></span>
            </div>
          ) : (
            <span>{caso.descripcion || 'Extracción pericial, preservación de cadena de custodia, clonado bit-a-bit y análisis forense de evidencia digital pertinente conforme a la normativa vigente.'}</span>
          )}
        </div>
      </div>
    </div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={2}
      modo={modo}
    />
  </div>

  <!-- ==================== HOJA 2 DE 2 ==================== -->
  <div class="page">
    <div class="watermark">PRESERVACIÓN</div>

    <PlanillaHeader
      title="Acta de Obtención y Preservación (Continuación)"
      norma="MUCC-2017 · ISO/IEC 27037 §5.3–5.4 · COPP ART. 187"
      codigoDoc="FO-FOR-03"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={2}
      totalHojas={2}
    />

    <div class="planilla-body">
      <!-- 5.0 EMBALAJE Y CONDICIÓN DE SEGURIDAD -->
      <div class="section-block">
        <div class="section-heading">5.0 MEDIDAS DE PRESERVACIÓN, AISLAMIENTO Y EMBALAJE (MUCC-2017)</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Bolsa Faraday N° (Aislamiento RF):</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual" data-field="bolsa_faraday_numero"></span> : <span data-field="bolsa_faraday_numero">{caso.bolsa_faraday_numero || 'FARADAY-2026-001'}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Precinto de Seguridad Inicial N°:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual" data-field="precinto_numero"></span> : <span data-field="precinto_numero">{caso.precinto_numero || 'PREC-2026-991'}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Aislamiento Electromagnético:</span>
            <div class="field-value">
              {isBlanco ? <span>[&nbsp;&nbsp;] Modo Avión &nbsp;&nbsp; [&nbsp;&nbsp;] Faraday &nbsp;&nbsp; [&nbsp;&nbsp;] Apagado</span> : <span>[&nbsp;X&nbsp;] Bolsa Faraday Certificada &nbsp;&nbsp; [&nbsp;X&nbsp;] Modo Avión</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Protección Contra Escritura:</span>
            <div class="field-value">
              {isBlanco ? <span>[&nbsp;&nbsp;] Bloqueador Hardware &nbsp;&nbsp; [&nbsp;&nbsp;] Software Read-Only</span> : <span>[&nbsp;X&nbsp;] Bloqueador de Escritura por Hardware (Tableau/WiebeTech)</span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 6.0 DECLARACIÓN JURADA -->
      <div class="legal-clause">
        <strong>6.0 DECLARACIÓN JURADA DE CONSIGNACIÓN Y CADENA DE CUSTODIA (COPP ART. 187):</strong> En este acto se hace entrega formal de la evidencia digital precedentemente individualizada al personal pericial del Laboratorio SHA256.US. El perito receptor verifica los números de serial, condición de embalaje e integridad de los precintos numerados, abriendo formalmente el Registro de Cadena de Custodia (PRCC) bajo apercibimiento de las sanciones de ley previstas en los Arts. 187 y 225 del Código Orgánico Procesal Penal.
      </div>
    </div>

    <!-- 7.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="QUIEN ENTREGA / CONSIGNANTE"
      peritoTitulo="QUIEN RECIBE / PERITO RECEPTOR SHA256.US"
      solicitanteNombre={caso.solicitante_nombre}
      solicitanteCedula={caso.solicitante_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion={caso.solicitante_direccion}
      peritoNombre={caso.peritoLider}
      peritoCedula={caso.perito_cedula}
      peritoCiv={caso.perito_civ}
      peritoInpre={caso.perito_inpre}
      peritoCargo={caso.perito_cargo}
      rolIso="DEFR · ISO/IEC 27037"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={2}
      totalHojas={2}
      modo={modo}
    />
  </div>
</div>
