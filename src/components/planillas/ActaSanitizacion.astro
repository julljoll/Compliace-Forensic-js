---
/**
 * SHA256.US — Acta de Sanitización Criptográfica y Borrado Seguro
 * Fundamentación: NIST SP 800-88 Rev. 1 · ISO/IEC 27001 · CRBV Art. 60 · LEDCI Arts. 20 y 22.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">SANITIZACIÓN</div>

    <PlanillaHeader
      title="Acta de Sanitización Criptográfica y Borrado Seguro"
      norma="NIST SP 800-88 REV. 1 · ISO/IEC 27001 · LEDCI ARTS. 20 Y 22"
      codigoDoc="ACT-SAN-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 IDENTIFICACIÓN DE MEDIOS TEMPORALES -->
      <div class="section-block">
        <div class="section-heading">1.0 VOLÚMENES TEMPORALES Y COPIAS LÓGICAS DE TRABAJO A SANITIZAR</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 28%;">Volumen / Servidor:</th>
              <td style="width: 72%;">{isBlanco ? <span class="linea-manual"></span> : <span>Nodo Storage SHA256 · Vol. Encriptado ZFS-POOL-02 / NVMe Forense</span>}</td>
            </tr>
            <tr>
              <th>Serial del Medio de Trabajo:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>SN: MZ-V8P2T0B-EU-20261109 · Partición Volátil de Análisis</span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 Previo:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 PROTOCOLO Y TÉCNICA DE BORRADO -->
      <div class="section-block">
        <div class="section-heading">2.0 PROTOCOLO DE DESTRUCCIÓN LÓGICA CONFORME A NIST SP 800-88 REV. 1</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 30%;">Parámetro de Sanitización</th>
              <th style="width: 35%;">Especificación Técnica</th>
              <th style="width: 35%;">Verificación Forense</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Nivel de Sanitización NIST</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : 'PURGE (Crypto-Erase)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Destrucción irreversible de llaves criptográficas.</span>}</td>
            </tr>
            <tr>
              <td>Método de Sobrescritura</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : 'DoD 5220.22-M (3 Pases Pseudorandom)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Pase 1: 0x00 · Pase 2: 0xFF · Pase 3: Aleatorio.</span>}</td>
            </tr>
            <tr>
              <td>Software / Utilidad Empleada</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : 'Nwipe v0.34 / Linux shred / ZFS destroy'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Comprobación de eliminación de sectores lógicos.</span>}</td>
            </tr>
            <tr>
              <td>Verificación de No Remanencia</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : '100% de Sectores Verificados (0x00)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Lectura completa sin datos remanentes.</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 CONSTANCIA DE NO REMANENCIA -->
      <div class="section-block">
        <div class="section-heading">3.0 AUDITORÍA DE NO RETENCIÓN Y DEBER DE CONFIDENCIALIDAD (LEDCI ART. 22)</div>
        <div style="font-size: 7.2pt; line-height: 1.35; padding: 2px;">
          {isBlanco ? (
            <div class="lineas-pautadas-2">
              <span class="renglon-manual"></span>
              <span class="renglon-manual"></span>
            </div>
          ) : (
            <span>Se certifica formalmente que una vez entregado el dictamen pericial al cliente y devuelto el teléfono consignado, todas las copias lógicas de trabajo, volcados de SQLite msgstore.db, transcripciones de notas de voz y archivos temporales en los servidores del laboratorio fueron purgados y sobrescritos de forma irreversible, cumpliendo el deber de no retención de data personal ajena previsto en los Arts. 20 y 22 de la LEDCI y Art. 60 de la CRBV.</span>
          )}
        </div>
      </div>

      <!-- 4.0 DECLARACIÓN DE JURAMENTO -->
      <div class="legal-clause">
        <strong>4.0 FE DE JURAMENTO:</strong> El perito responsable y el oficial de cumplimiento certifican bajo juramento que no se conserva en los sistemas del laboratorio ninguna copia de las comunicaciones privadas del consignante, salvaguardando plenamente el secreto y privacidad de la información.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO RESPONSABLE DE SANITIZACIÓN"
      peritoTitulo="AUDITOR DE COMPLIANCE FORENSE"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Oficial de Compliance"
      peritoCedula="V-20.111.222"
      peritoCiv="CIV-299841"
      peritoInpre="INPRE-184510"
      peritoCargo="Auditor Interno de Seguridad ISO 27001"
      rolIso="DPA (Data Protection Auditor) · ISO 37301"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
