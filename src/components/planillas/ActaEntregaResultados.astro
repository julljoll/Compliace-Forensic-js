---
/**
 * SHA256.US — Acta de Disposición Final y Devolución de Evidencias
 * Fundamentación: MUCC-2017 Disposición Final (Gaceta Oficial N° 41.247) · COPP Art. 187 · Cierre de Custodia.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">DISPOSICIÓN FINAL</div>

    <PlanillaHeader
      title="Acta de Disposición Final y Devolución de Evidencias"
      norma="MUCC-2017 DISPOSICIÓN FINAL (G.O. 41.247) · COPP ART. 187"
      codigoDoc="ACT-ENT-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 DATOS DEL ACTO DE DISPOSICIÓN FINAL -->
      <div class="section-block">
        <div class="section-heading">1.0 DATOS DEL ACTO DE DISPOSICIÓN FINAL Y CIERRE (MUCC-2017)</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 25%;">Lugar del Acto:</td>
              <td class="forense-cell-value" style="width: 35%;">
                {isBlanco ? <span class="linea-manual"></span> : <span>Sede Laboratorio Forense SHA256.US · Quíbor, Estado Lara</span>}
              </td>
              <td class="forense-cell-label" style="width: 20%;">Fecha y Hora:</td>
              <td class="forense-cell-value font-mono" style="width: 20%;">
                {isBlanco ? <span class="linea-manual"></span> : <span>{new Date().toLocaleDateString('es-VE')} · 12:00 VET</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Modalidad:</td>
              <td class="forense-cell-value" colspan="3" style="font-weight: 700;">
                {isBlanco ? <span>[&nbsp;&nbsp;] DEVOLUCIÓN AL TITULAR CONSIGNANTE &nbsp;&nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] ENTREGA A AUTORIDAD JUDICIAL</span> : <span>[&nbsp;X&nbsp;] DEVOLUCIÓN AL CONSIGNANTE TITULAR (CIERRE FORMAL DE CUSTODIA)</span>}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 IDENTIFICACIÓN DEL RECEPTOR -->
      <div class="section-block">
        <div class="section-heading">2.0 IDENTIFICACIÓN DEL CONSIGNANTE RECEPTOR DE EVIDENCIAS</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 25%;">Nombre y Apellido:</td>
              <td class="forense-cell-value" style="width: 35%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_nombre"></span> : <span data-field="solicitante_nombre">{caso.solicitante_nombre || caso.receptor_nombre}</span>}
              </td>
              <td class="forense-cell-label" style="width: 20%;">C.I. / RIF:</td>
              <td class="forense-cell-value font-mono" style="width: 20%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_cedula"></span> : <span data-field="solicitante_cedula">{caso.solicitante_cedula || caso.receptor_cedula}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Carácter del Receptor:</td>
              <td class="forense-cell-value" colspan="3">
                {isBlanco ? <span>[&nbsp;&nbsp;] Titular Consignante Original &nbsp;&nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] Apoderado Legal con Poder</span> : <span>[ X ] Titular Consignante Original</span>}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 RELACIÓN DE ENTREGABLES -->
      <div class="section-block">
        <div class="section-heading">3.0 RELACIÓN DE DOCUMENTOS, DISPOSITIVOS Y COPIAS MASTER ENTREGADAS</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 8%; text-align: center;">Item</th>
              <th style="width: 62%;">Descripción del Elemento / Documento Entregado</th>
              <th style="width: 30%;">Estado / Verificación</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="text-align: center; font-weight: bold;">01</td>
              <td>Dictamen Pericial Oficial Impreso en Papel Folio (Original Colegiado)</td>
              <td>{isBlanco ? <span>[&nbsp;&nbsp;] RECIBIDO SELLADO</span> : <span>[ X ] Rubricado y Sellado</span>}</td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: bold;">02</td>
              <td>Copia Forense Digital Inmutable (Soporte Digital con Extracción Lógica)</td>
              <td>{isBlanco ? <span>[&nbsp;&nbsp;] HASH VERIFICADO</span> : <span>[ X ] Hash Validado</span>}</td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: bold;">03</td>
              <td>Dispositivo Smartphone Peritado (Devolución en su embalaje de seguridad)</td>
              <td>{isBlanco ? <span>[&nbsp;&nbsp;] PRECINTO ÍNTEGRO</span> : <span>[ X ] Precinto de Resguardo Intacto</span>}</td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: bold;">04</td>
              <td>Hash SHA-256 de Cierre de Custodia:</td>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente'}</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 4.0 CLÁUSULA DE CONFORMIDAD -->
      <div class="legal-clause">
        <strong>4.0 DECLARACIÓN DE RECEPCIÓN Y CONFORMIDAD (MUCC-2017 · COPP ART. 187):</strong> El consignante titular declara recibir los elementos supra descritos a su entera satisfacción, certificando la indemnidad del teléfono celular devuelto, la integridad del precinto de resguardo y los recaudos periciales emitidos por el laboratorio, dándose por concluido el proceso de custodia conforme al ordenamiento jurídico venezolano.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="RECIBE CONFORME (TITULAR CONSIGNANTE)"
      peritoTitulo="ENTREGA CONFORME (PERITO FORENSE RESPONSABLE)"
      solicitanteNombre={caso.solicitante_nombre || caso.receptor_nombre}
      solicitanteCedula={caso.solicitante_cedula || caso.receptor_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion={caso.solicitante_direccion}
      peritoNombre={caso.peritoLider}
      peritoCedula={caso.perito_cedula}
      peritoCiv="CIV-289410"
      peritoInpre="INPRE-179420"
      peritoCargo="Jefe de Laboratorio Forense"
      rolIso="DEC (Digital Evidence Custodian) · MUCC-2017"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
