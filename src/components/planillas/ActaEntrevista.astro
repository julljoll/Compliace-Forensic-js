---
/**
 * SHA256.US — Acta de Entrevista Forense al Consignante
 * Fundamentación: MUCC-2017 & ISO/IEC 27042 · CRBV Art. 49 ord. 5° · Código Penal Art. 242.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">ENTREVISTA</div>

    <PlanillaHeader
      title="Acta de Entrevista Técnico-Pericial al Consignante"
      norma="MUCC-2017 · CRBV ART. 49 ORD. 5° · CP ART. 242 · ISO/IEC 27042"
      codigoDoc="FO-FOR-02"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 DATOS DE IDENTIFICACIÓN -->
      <div class="section-block">
        <div class="section-heading">1.0 IDENTIFICACIÓN DEL CONSIGNANTE Y NOTIFICACIÓN CONSTITUCIONAL</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 22%;">Apellidos y Nombres:</td>
              <td class="forense-cell-value" style="width: 28%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_nombre"></span> : <span data-field="solicitante_nombre">{caso.solicitante_nombre}</span>}
              </td>
              <td class="forense-cell-label" style="width: 22%;">Cédula de Identidad / RIF:</td>
              <td class="forense-cell-value font-mono" style="width: 28%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_cedula"></span> : <span data-field="solicitante_cedula">{caso.solicitante_cedula}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Teléfono de Contacto:</td>
              <td class="forense-cell-value font-mono">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_telefono"></span> : <span data-field="solicitante_telefono">{caso.solicitante_telefono}</span>}
              </td>
              <td class="forense-cell-label">Dirección de Habitación:</td>
              <td class="forense-cell-value">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_direccion"></span> : <span data-field="solicitante_direccion">{caso.solicitante_direccion}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Garantía Constitucional:</td>
              <td class="forense-cell-value" colspan="3" style="font-size: 6.8pt; line-height: 1.25;">
                Notificación expresa de la garantía contra la autoincriminación (CRBV Art. 49 ord. 5°). El consignante declara libre y voluntariamente bajo juramento de ley.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 CUESTIONARIO FORENSE ESTRUCTURADO -->
      <div class="section-block">
        <div class="section-heading">2.0 CUESTIONARIO TÉCNICO DIRIGIDO A LA EXTRACCIÓN LÓGICA (ISO/IEC 27042)</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 5%;">N°</th>
              <th style="width: 45%;">Pregunta Técnica Formulada</th>
              <th style="width: 50%;">Declaración / Respuesta del Consignante</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="text-align: center; font-weight: 700;">1</td>
              <td>¿Cuál es el objeto pericial y qué chats, audios o números son de interés?</td>
              <td>
                {isBlanco ? (
                  <div class="lineas-pautadas-2">
                    <span class="renglon-manual"></span>
                    <span class="renglon-manual"></span>
                  </div>
                ) : (
                  <span>{caso.descripcion || 'Extracción y validación de autenticidad de chats y audios WhatsApp'}</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">2</td>
              <td>¿Suministra voluntariamente el PIN, patrón o contraseña de desbloqueo?</td>
              <td>
                {isBlanco ? (
                  <span>[&nbsp;&nbsp;] SÍ &nbsp;&nbsp; [&nbsp;&nbsp;] NO &nbsp;&nbsp; Credencial: <span class="linea-manual" style="display:inline-block; width:45%; min-height:16px;"></span></span>
                ) : (
                  <span>[ X ] Suministrado voluntariamente en sobre lacrado</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">3</td>
              <td>¿Cuál es el rango de fechas y horas aproximadas de las comunicaciones?</td>
              <td>
                {isBlanco ? (
                  <span class="linea-manual"></span>
                ) : (
                  <span>Rango activo delimitado en el encargo pericial</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">4</td>
              <td>¿El dispositivo o la app sufrieron desinstalaciones, caídas o manipulación?</td>
              <td>
                {isBlanco ? (
                  <span>[&nbsp;&nbsp;] NO &nbsp;&nbsp; [&nbsp;&nbsp;] SÍ &nbsp;&nbsp; Observación: <span class="linea-manual" style="display:inline-block; width:42%; min-height:16px;"></span></span>
                ) : (
                  <span>[ X ] Negativo; sistema operativo y base de datos íntegros</span>
                )}
              </td>
            </tr>
            <tr>
              <td style="text-align: center; font-weight: 700;">5</td>
              <td>¿Autoriza la preservación lógica y generación de copia forense de los chats?</td>
              <td>
                {isBlanco ? (
                  <span>[&nbsp;&nbsp;] SÍ AUTORIZO &nbsp;&nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] NO AUTORIZO</span>
                ) : (
                  <span>[ X ] SÍ AUTORIZA (Extracción Lógica NIST Nivel 2)</span>
                )}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 DECLARACIÓN DE VERACIDAD -->
      <div class="legal-clause">
        <strong>3.0 DECLARACIÓN DE VERACIDAD Y CONFORMIDAD LEGAL:</strong> El entrevistado manifiesta bajo fe de juramento que los datos y credenciales aportados son fidedignos, con pleno conocimiento de las sanciones legales por falso testimonio previstas en el Art. 242 del Código Penal Venezolano, autorizando la incorporación de esta acta al expediente técnico para sustentar la licitud de la prueba digital.
      </div>
    </div>

    <!-- 4.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="DECLARANTE / ENTREVISTADO"
      peritoTitulo="PERITO ENTREVISTADOR SHA256.US"
      solicitanteNombre={caso.solicitante_nombre}
      solicitanteCedula={caso.solicitante_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion={caso.solicitante_direccion}
      peritoNombre={caso.peritoLider}
      peritoCedula={caso.perito_cedula}
      peritoCiv={caso.perito_civ}
      peritoInpre={caso.perito_inpre}
      peritoCargo={caso.perito_cargo}
      rolIso="DEFR · ISO/IEC 27037"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
