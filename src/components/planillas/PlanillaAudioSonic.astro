---
/**
 * SHA256.US — Planilla de Análisis Forense de Audio y Espectrograma
 * Fundamentación: LMDFE Arts. 4 y 7 · Ley Protección a la Privacidad de Comunicaciones Art. 2 · ISO/IEC 27042 §7–8.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">AUDIO FORENSE</div>

    <PlanillaHeader
      title="Planilla de Análisis Forense de Audio y Espectrograma"
      norma="LMDFE ARTS. 4 Y 7 · ISO/IEC 27042 §7–8 · SWGDE AUDIO"
      codigoDoc="FO-AUD-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 IDENTIFICACIÓN DEL ARCHIVO -->
      <div class="section-block">
        <div class="section-heading">1.0 IDENTIFICACIÓN DE LA NOTA DE VOZ DE WHATSAPP Y HASH SHA-256</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Nombre de Archivo:</th>
              <td style="width: 75%;">{isBlanco ? <span class="linea-manual"></span> : <span>AUD_WHATSAPP_NOTA_VOZ.opus (Flujo Nativo Opus en Ogg)</span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 del Audio:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Herramienta Utilizada:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Sonic Visualiser v5.0.1 / Praat Phonetics (Algoritmos FFT &amp; YIN de Pitch)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 PARÁMETROS TÉCNICOS ACÚSTICOS -->
      <div class="section-block">
        <div class="section-heading">2.0 ESPECIFICACIONES TÉCNICAS ACÚSTICAS Y METADATOS DE TRANSMISIÓN</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 17%;">Frecuencia:</td>
              <td class="forense-cell-value font-mono" style="width: 16%;">{isBlanco ? <span class="linea-manual"></span> : <span>48.000 Hz</span>}</td>
              <td class="forense-cell-label" style="width: 17%;">Canales:</td>
              <td class="forense-cell-value" style="width: 16%;">{isBlanco ? <span class="linea-manual"></span> : <span>1 Canal (Mono)</span>}</td>
              <td class="forense-cell-label" style="width: 17%;">Profundidad:</td>
              <td class="forense-cell-value font-mono" style="width: 17%;">{isBlanco ? <span class="linea-manual"></span> : <span>16 bits / VBR</span>}</td>
            </tr>
            <tr>
              <td class="forense-cell-label">Duración:</td>
              <td class="forense-cell-value font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>00:01:42.850</span>}</td>
              <td class="forense-cell-label">Formato / Códec:</td>
              <td class="forense-cell-value">{isBlanco ? <span class="linea-manual"></span> : <span>Opus (RFC 6716)</span>}</td>
              <td class="forense-cell-label">Contenedor:</td>
              <td class="forense-cell-value">{isBlanco ? <span class="linea-manual"></span> : <span>Ogg (.opus)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 ANÁLISIS ESPECTROGRÁFICO -->
      <div class="section-block">
        <div class="section-heading">3.0 COTEJO ESPECTROGRÁFICO, CONTINUIDAD Y DETECCIÓN ANTI-DEEPFAKE</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 35%;">Control Pericial Acústico</th>
              <th style="width: 25%;">Resultado</th>
              <th style="width: 40%;">Observación Científica</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Continuidad de Ruido de Fondo (Noise Floor)</td>
              <td style="font-weight: 700;">{isBlanco ? <span>[&nbsp;&nbsp;] CONTINUO &nbsp; [&nbsp;&nbsp;] DISCONT.</span> : 'CONTINUO (SIN CORTES)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Piso de ruido acústico homogéneo a -54 dBFS sin saltos.</span>}</td>
            </tr>
            <tr>
              <td>Formantes Vocálicos Laríngeos (F1-F4)</td>
              <td style="font-weight: 700;">{isBlanco ? <span>[&nbsp;&nbsp;] HUMANO &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] SINTÉTICO</span> : 'VOZ BIOLÓGICA AUTÉNTICA'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Micro-temblores y jitter propios de emisión humana natural.</span>}</td>
            </tr>
            <tr>
              <td>Detección de Edición o Manipulación</td>
              <td style="font-weight: 700;">{isBlanco ? <span>[&nbsp;&nbsp;] SIN EDICIÓN &nbsp; [&nbsp;&nbsp;] EDITADO</span> : 'SIN VESTIGIOS DE EDICIÓN'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Ausencia de cortes, empalmes o transcodificaciones anómalas.</span>}</td>
            </tr>
            <tr>
              <td>Frecuencia Eléctrica de Red (ENF 60 Hz)</td>
              <td style="font-weight: 700;">{isBlanco ? <span>[&nbsp;&nbsp;] TRAZA 60 Hz &nbsp; [&nbsp;&nbsp;] NO DETECT.</span> : 'TRAZA DE 60 Hz DETECTADA'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Coherente con el suministro eléctrico nacional venezolano.</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 4.0 CONCLUSIONES ACÚSTICAS -->
      <div class="legal-clause">
        <strong>4.0 CONCLUSIONES DEL PERITAJE DE AUDIO:</strong> La nota de voz peritada es <strong>AUTÉNTICA E ÍNTEGRA</strong>. Cumple con los requisitos de mensaje de datos original conforme al Art. 7 de la LMDFE, habiendo sido aportada por el interlocutor legítimo sin vulnerar la privacidad de terceros (Art. 2 Ley sobre Protección a la Privacidad de las Comunicaciones).
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO EN ACÚSTICA FORENSE"
      peritoTitulo="PERITO COORDINADOR REVISOR"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Co-Perito Acústico"
      peritoCedula="V-17.442.991"
      peritoCiv="CIV-281014"
      peritoInpre="INPRE-174820"
      peritoCargo="Especialista en Señales de Audio"
      rolIso="DES (Digital Evidence Specialist) · ISO 27042"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
