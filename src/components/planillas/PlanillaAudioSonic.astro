---
/**
 * SHA256.US — Planilla de Análisis Forense de Audio y Espectrograma
 * Fundamentación: ISO/IEC 27042 §7–8 · Sonic Visualiser & Análisis Biométrico de Voz.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">AUDIO FORENSE</div>

    <PlanillaHeader
      title="Planilla de Análisis Forense de Audio y Espectrograma"
      norma="ISO/IEC 27042 §7–8 · REPETIBILIDAD CIENTÍFICA DAUBERT"
      codigoDoc="FO-AUD-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 IDENTIFICACIÓN DEL ARCHIVO -->
      <div class="section-block">
        <div class="section-heading">1.0 IDENTIFICACIÓN DEL ARCHIVO DE AUDIO Y TRAZABILIDAD HASH</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Nombre de Archivo:</th>
              <td style="width: 75%;">{isBlanco ? <span class="linea-manual"></span> : <span>EVIDENCIA_AUDIO_NOTA_VOZ.opus (Contenedor Ogg)</span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 del Audio:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Herramienta Utilizada:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Sonic Visualiser v5.0.1 / Praat Phonetics v6.3.14 (Plugins FFT Vamp)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 PARÁMETROS TÉCNICOS ACÚSTICOS -->
      <div class="section-block">
        <div class="section-heading">2.0 PARÁMETROS TÉCNICOS ACÚSTICOS Y METADATOS DE CONTENEDOR</div>
        <div class="form-grid-3">
          <div class="field-row">
            <span class="field-label">Frecuencia de Muestreo:</span>
            <div class="field-value font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>48.000 Hz (48 kHz)</span>}</div>
          </div>
          <div class="field-row">
            <span class="field-label">Canales de Audio:</span>
            <div class="field-value">{isBlanco ? <span class="linea-manual"></span> : <span>1 Canal (Mono)</span>}</div>
          </div>
          <div class="field-row">
            <span class="field-label">Profundidad de Bits:</span>
            <div class="field-value font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>16 bits / Variable Bitrate</span>}</div>
          </div>
          <div class="field-row">
            <span class="field-label">Duración Exacta:</span>
            <div class="field-value font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>00:01:42.850 ms</span>}</div>
          </div>
          <div class="field-row">
            <span class="field-label">Formato / Códec:</span>
            <div class="field-value">{isBlanco ? <span class="linea-manual"></span> : <span>Opus Audio Codec (IETF RFC 6716)</span>}</div>
          </div>
          <div class="field-row">
            <span class="field-label">Contenedor:</span>
            <div class="field-value">{isBlanco ? <span class="linea-manual"></span> : <span>Ogg Container (.ogg / .opus)</span>}</div>
          </div>
        </div>
      </div>

      <!-- 3.0 ANÁLISIS ESPECTROGRÁFICO -->
      <div class="section-block">
        <div class="section-heading">3.0 RESULTADOS DEL ANÁLISIS ESPECTROGRÁFICO Y CONTINUIDAD</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 35%;">Control Pericial Acústico</th>
              <th style="width: 25%;">Resultado</th>
              <th style="width: 40%;">Observación Científica</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Continuidad de Ruido de Fondo (Noise Floor)</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONTINUO (SIN CORTES)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Nivel de piso de ruido ambiente homogéneo a -54 dBFS.</span>}</td>
            </tr>
            <tr>
              <td>Análisis de Frecuencias Formantes (F1-F4)</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'COMPATIBLE CON VOZ HUMANA'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Resonancias de tracto vocal consistentes, sin modulación artificial.</span>}</td>
            </tr>
            <tr>
              <td>Detección de Edición o Inserciones</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'NO SE DETECTAN EDICIONES'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Sin saltos de fase ni anomalías espectrales en transiciones.</span>}</td>
            </tr>
            <tr>
              <td>Análisis de ENF (Frecuencia de Red Eléctrica)</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'TRAZA DE 60 Hz PRESENTE'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Firma eléctrica de red de 60 Hz típica del sistema venezolano.</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 4.0 CONCLUSIONES ACÚSTICAS -->
      <div class="legal-clause">
        <strong>4.0 CONCLUSIONES DEL PERITAJE DE AUDIO:</strong> La pista analizada presenta integridad acústica plena y continuidad ininterrumpida de sus frecuencias espectrales. No se aprecian artefactos de empalme, sobregrabación, clonación de voz por IA ni manipulación digital que altere su valor convictivo legal.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO EN ACÚSTICA FORENSE"
      peritoTitulo="PERITO COORDINADOR REVISOR"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Co-Perito Acústico"
      peritoCedula="V-17.442.991"
      peritoCiv="CIV-281014"
      peritoInpre="INPRE-174820"
      peritoCargo="Especialista en Señales de Audio"
      rolIso="DES (Digital Evidence Specialist) · ISO 27042"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
