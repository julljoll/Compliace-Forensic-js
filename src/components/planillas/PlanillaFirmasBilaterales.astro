---
/**
 * SHA256.US — Bloque Canónico de Cierre Legal: Firmas y Huellas Dactilares Bilaterales
 * Cumple con COPP Arts. 187, 223–225 y MUCC-2017.
 * Presenta 2 columnas equilibradas con líneas de firma sólidas y recuadros dactilares dobles.
 */
interface Props {
  consignanteTitulo?: string;
  peritoTitulo?: string;
  solicitanteNombre?: string;
  solicitanteCedula?: string;
  solicitanteTelefono?: string;
  solicitanteDireccion?: string;
  peritoNombre?: string;
  peritoCedula?: string;
  peritoCiv?: string;
  peritoInpre?: string;
  peritoCargo?: string;
  rolIso?: string;
  modo?: 'blanco' | 'datos';
}

const {
  consignanteTitulo = 'CONSIGNANTE / DECLARANTE',
  peritoTitulo = 'PERITO OFICIAL RESPONSABLE',
  solicitanteNombre = '',
  solicitanteCedula = '',
  solicitanteTelefono = '',
  solicitanteDireccion = '',
  peritoNombre = '',
  peritoCedula = '',
  peritoCiv = '',
  peritoInpre = '',
  peritoCargo = '',
  rolIso = 'DEFR (Digital Evidence First Responder)',
  modo = 'blanco',
} = Astro.props;

const isBlanco = modo === 'blanco';
---

<div class="canonical-signatures">
  <!-- Columna Izquierda: Consignante / Declarante -->
  <div class="sig-box">
    <div class="sig-box-title">{consignanteTitulo}</div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">NOMBRE:</strong>
      <span style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="solicitante_nombre">{isBlanco ? '' : solicitanteNombre}</span>
    </div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">C.I. / RIF:</strong>
      <span class="font-mono" style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="solicitante_cedula">{isBlanco ? '' : solicitanteCedula}</span>
    </div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">TELÉFONO:</strong>
      <span class="font-mono" style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="solicitante_telefono">{isBlanco ? '' : solicitanteTelefono}</span>
    </div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">DIRECCIÓN:</strong>
      <span style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="solicitante_direccion">{isBlanco ? '' : solicitanteDireccion}</span>
    </div>

    <div class="sig-line-solid sig-line"></div>
    <div class="sig-legend">Firma del Consignante / Solicitante</div>

    <div class="fingerprint-container">
      <div class="fingerprint-item">
        <div class="thumb-box-canonical"></div>
        <span class="thumb-box-label">PULGAR DER.</span>
      </div>
      <div class="fingerprint-item">
        <div class="thumb-box-canonical"></div>
        <span class="thumb-box-label">PULGAR IZQ.</span>
      </div>
    </div>
  </div>

  <!-- Columna Derecha: Perito Oficial SHA256.US -->
  <div class="sig-box">
    <div class="sig-box-title">{peritoTitulo}</div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">PERITO LÍDER:</strong>
      <span style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="peritoLider">{isBlanco ? '' : (peritoNombre || 'Jull Joll (Perito Principal)')}</span>
    </div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">C.I. N°:</strong>
      <span class="font-mono" style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="perito_cedula">{isBlanco ? '' : (peritoCedula || 'V-18.999.001')}</span>
    </div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">CIV / INPRE:</strong>
      <span class="font-mono" style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="perito_civ">{isBlanco ? '' : `CIV: ${peritoCiv || '299410'} · INPRE: ${peritoInpre || '184920'}`}</span>
    </div>
    <div class="sig-data-row" style="display: flex; align-items: flex-end; margin-bottom: 2px;">
      <strong style="white-space: nowrap; margin-right: 4px;">CARGO / ROL:</strong>
      <span style="flex: 1; border-bottom: 1px solid #000; min-height: 14px; padding-left: 2px;" data-field="perito_cargo">{isBlanco ? '' : `${peritoCargo || 'Perito Informático Forense'} (${rolIso})`}</span>
    </div>

    <div class="sig-line-solid sig-line"></div>
    <div class="sig-legend">Firma y Sello del Perito Oficial</div>

    <div class="fingerprint-container">
      <div class="fingerprint-item">
        <div class="thumb-box-canonical"></div>
        <span class="thumb-box-label">PULGAR DER.</span>
      </div>
      <div class="fingerprint-item">
        <div class="thumb-box-canonical"></div>
        <span class="thumb-box-label">PULGAR IZQ.</span>
      </div>
    </div>
  </div>
</div>
