---
/**
 * SHA256.US — Planilla de Evaluación de Calidad de Software e Interfaz UX
 * Fundamentación: ISO/IEC 25010 · ISO/IEC 27042 §8 · LMDFE Art. 4 · Cotejo de Interfaz vs SQLite.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">EVALUACIÓN UX</div>

    <PlanillaHeader
      title="Planilla de Evaluación de Interfaz UX y Calidad de Software"
      norma="ISO/IEC 25010 · ISO/IEC 27042 §8 · LMDFE ART. 4"
      codigoDoc="FO-UX-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 SISTEMA EVALUADO -->
      <div class="section-block">
        <div class="section-heading">1.0 APLICACIÓN EVALUADA Y ENTORNO DE EJECUCIÓN (WHATSAPP / SO MÓVIL)</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Nombre del Software / Plataforma:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual"></span> : <span>WhatsApp Messenger / Meta Platforms Inc.</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Versión de Compilación y Sistema:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual"></span> : <span>WhatsApp v2.24.x · Android OS / iOS nativo</span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 2.0 MATRIZ HEURÍSTICA FORENSE -->
      <div class="section-block">
        <div class="section-heading">2.0 MATRIZ DE COTEJO FORENSE: INTERFAZ EN PANTALLA VS REGISTROS SQLITE</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 30%;">Criterio de Evaluación</th>
              <th style="width: 25%;">Resultado</th>
              <th style="width: 45%;">Comprobación Pericial</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sincronía de Sellos Temporales (Timestamps)</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME (100% MATCH)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Hora visual coincide con época UNIX en msgstore.db.</span>}</td>
            </tr>
            <tr>
              <td>Estados de Envío (Ticks / Checks)</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME (AUTÉNTICO)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Estados de entrega/lectura corroborados en status flag.</span>}</td>
            </tr>
            <tr>
              <td>Identificación de Remitente (JID)</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME (VERIFICADO)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Número de abonado internacional fijado en key_remote_jid.</span>}</td>
            </tr>
            <tr>
              <td>Detección de Falsificaciones de Pantalla</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'DESCARTE NEGATIVO'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Ausencia de generadores de chat falso (WhatsFake / clonados).</span>}</td>
            </tr>
            <tr>
              <td>No Repudio de Contenido</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME (PLENA EFICACIA)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Correspondencia entre el texto en pantalla y registro en base.</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 DICTAMEN DE CONFORMIDAD -->
      <div class="legal-clause">
        <strong>3.0 DICTAMEN DE CONFORMIDAD DE SOFTWARE:</strong> Se concluye que la visualización gráfica de los chats en pantalla corresponde de forma fidedigna y unívoca con los registros crudos extraídos de la base de datos nativa SQLite, sin que existan indicios de simulación, emulación maliciosa ni captura editada, gozando de plena eficacia técnica conforme al Art. 4 de la LMDFE.
      </div>
    </div>

    <!-- 4.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO EVALUADOR DE SOFTWARE"
      peritoTitulo="PERITO COORDINADOR DE CALIDAD"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Co-Perito de Calidad"
      peritoCedula="V-16.904.312"
      peritoCiv="CIV-274190"
      peritoInpre="INPRE-165219"
      peritoCargo="Especialista en Evaluación de Software"
      rolIso="DES · ISO/IEC 25010"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
