---
/**
 * SHA256.US — Planilla de Evaluación de Calidad de Software e Interfaz UX
 * Fundamentación: ISO/IEC 25010 · Evaluación Heurística y Calidad de Evidencia en Pantalla.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">EVALUACIÓN UX</div>

    <PlanillaHeader
      title="Planilla de Evaluación de Calidad de Software y UX"
      norma="ISO/IEC 25010 · HEURÍSTICA FORENSE DE INTERFAZ"
      codigoDoc="FO-UX-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 SISTEMA EVALUADO -->
      <div class="section-block">
        <div class="section-heading">1.0 APLICACIÓN / SISTEMA EVALUADO Y ENTORNO DE EJECUCIÓN</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Nombre del Software / Plataforma:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual"></span> : <span>{caso.tipoProyecto === 'forense_whatsapp' ? 'WhatsApp Messenger (Meta Inc.)' : (caso.tipoProyecto === 'forense_email' ? 'Cliente de Correo Electrónico (Thunderbird/Outlook)' : 'Sistema de Archivos y Almacenamiento')}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Versión de Compilación / Build:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual"></span> : <span>v2.24.12.78 (Android OS 14)</span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 2.0 MATRIZ HEURÍSTICA ISO 25010 -->
      <div class="section-block">
        <div class="section-heading">2.0 MATRIZ DE EVALUACIÓN HEURÍSTICA Y CONFORMIDAD FORENSE (ISO 25010)</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 30%;">Criterio de Calidad</th>
              <th style="width: 25%;">Evaluación</th>
              <th style="width: 45%;">Comprobación Pericial</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Legibilidad de Sellos de Tiempo (Timestamps)</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Marcas temporales UTC y locales sincronizadas con precisión.</span>}</td>
            </tr>
            <tr>
              <td>Integridad de Mensajería y Estados de Envío</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Iconografía de doble check gris/azul persistida en base de datos.</span>}</td>
            </tr>
            <tr>
              <td>Trazabilidad de Metadatos y Adjuntos</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Nombres de archivo, tamaños de byte y hashes reproducibles.</span>}</td>
            </tr>
            <tr>
              <td>Prevención de Manipulación Involuntaria</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Mecanismos de verificación biométrica y bloqueo de interfaz activos.</span>}</td>
            </tr>
            <tr>
              <td>Consistencia Visual y No Repudio</td>
              <td style="font-weight: 700;">{isBlanco ? '' : 'CONFORME'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Coincidencia 100% entre pantalla renderizada y registros brutos SQLite.</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 DICTAMEN DE CONFORMIDAD -->
      <div class="legal-clause">
        <strong>3.0 DICTAMEN DE CONFORMIDAD DE SOFTWARE:</strong> Concluye la evaluación heurística determinando que la interfaz de usuario bajo análisis no presenta distorsiones, emulaciones fraudulentas ni artefactos visuales artificiales, correspondiendo fehacientemente con el comportamiento estándar del software legítimo certificado.
      </div>
    </div>

    <!-- 4.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO EVALUADOR DE SOFTWARE"
      peritoTitulo="PERITO COORDINADOR DE CALIDAD"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Co-Perito de Calidad"
      peritoCedula="V-16.904.312"
      peritoCiv="CIV-274190"
      peritoInpre="INPRE-165219"
      peritoCargo="Especialista en Evaluación de Software"
      rolIso="DES · ISO/IEC 25010"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
