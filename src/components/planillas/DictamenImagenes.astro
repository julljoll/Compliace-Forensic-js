---
/**
 * SHA256.US — Dictamen Pericial de Autenticidad de Imágenes Digitales
 * ELA (Error Level Analysis), Copy-Move, EXIF Metadata & ISO 27042. Tamaño Folio (216mm x 330mm).
 */
import PlanillaFolioWrapper from './PlanillaFolioWrapper.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
}

const { caso = {} } = Astro.props;
const dictamenNum = caso.numeroCaso ? `D-IMG-${caso.numeroCaso}` : 'D-IMG-2026-0042';
---

<div class="folio-forense-aislado">
  <PlanillaFolioWrapper
    title="Dictamen Pericial de Imágenes Digitales"
    nroLabel="N° DICTAMEN:"
    nroValue={dictamenNum}
    watermarkText="DICTAMEN IMÁGENES"
  >
    <div class="uswds-top-header">
      INFORME TÉCNICO PERICIAL DE AUTENTICIDAD DE IMÁGENES — ELA MAP · COPY-MOVE · EXIF · ISO 27042
    </div>

    <!-- ENCABEZADO -->
    <div class="section">
      <div class="section-title">1.0 MARCO NORMATIVO Y ACREDITACIÓN PERICIAL</div>
      <div class="uswds-card">
        <div class="grid-container" style="grid-template-columns: 1fr 1fr; gap: 8px;">
          <div class="form-group">
            <div class="label">N° Expediente</div>
            <div class="value font-mono" contenteditable="true" data-field="numeroCaso">{caso.numeroCaso || '[EXPEDIENTE]'}</div>
          </div>
          <div class="form-group">
            <div class="label">Perito en Análisis de Imágenes</div>
            <div class="value" contenteditable="true" data-field="peritoLider">{caso.peritoLider || 'Perito Principal'}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ANÁLISIS ELA Y METADATOS -->
    <div class="section">
      <div class="section-title">2.0 ANÁLISIS ELA (ERROR LEVEL ANALYSIS) Y METADATOS EXIF</div>
      <table style="width: 100%; border-collapse: collapse; border: 1px solid #CBD5E1; font-size: 8.5pt;">
        <tbody>
          <tr style="border-bottom: 1px solid #CBD5E1;">
            <td style="padding: 6px 8px; width: 35%; font-weight: 700; background: #F8FAFC;">Mapa ELA</td>
            <td style="padding: 6px 8px;" contenteditable="true">Compresión homogénea en cuadrículas JPEG 8x8. Sin parches anómalos de resave.</td>
          </tr>
          <tr style="border-bottom: 1px solid #CBD5E1;">
            <td style="padding: 6px 8px; font-weight: 700; background: #F8FAFC;">Detección Copy-Move</td>
            <td style="padding: 6px 8px;" contenteditable="true">Algoritmo SIFT/SURF ejecutado con resultado negativo de duplicación o clonado.</td>
          </tr>
          <tr style="border-bottom: 1px solid #CBD5E1;">
            <td style="padding: 6px 8px; font-weight: 700; background: #F8FAFC;">Metadatos EXIF / JFIF</td>
            <td style="padding: 6px 8px;" contenteditable="true">Marcas de cámara y timestamp coincidentes con el dispositivo móvil incautado.</td>
          </tr>
          <tr>
            <td style="padding: 6px 8px; font-weight: 700; background: #F8FAFC;">Hash SHA-256 de la Imagen</td>
            <td style="padding: 6px 8px;" class="font-mono" contenteditable="true" data-field="hashSHA256">{caso.hashSHA256 || '[Hash SHA-256 de la imagen]'}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- CONCLUSIÓN PERICIAL -->
    <div class="section">
      <div class="section-title">3.0 CONCLUSIONES PERICIALES DE AUTENTICIDAD</div>
      <div class="form-group" contenteditable="true" style="min-height: 120px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 10px; font-size: 8.5pt; line-height: 20px; background: #FFFFFF;">
        Se concluye que las imágenes analizadas corresponden a capturas auténticas tomadas por el sensor óptico del dispositivo peritado. No se identificaron manipulaciones digitales, empalmes fotográficos ni edición posterior por software de retoque o modelos de difusión generativa (IA).
      </div>
    </div>

    <!-- FIRMAS BILATERALES -->
    <div class="signature-section" style="padding-top: 10px;">
      <div class="sig-detail-card">
        <div class="sig-detail-label">PERITO PRINCIPAL</div>
        <div class="sig-field" style="margin-top: 8px;">Nombre: <span class="sig-underline" contenteditable="true" data-field="peritoLider">{caso.peritoLider || 'Perito Principal'}</span></div>
        <div class="sig-field">C.I. N°: <span class="sig-underline" contenteditable="true" data-field="perito_cedula">{caso.perito_cedula || 'V-18.999.001'}</span></div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma del Perito Especialista</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR DER.</span></div>
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR IZQ.</span></div>
        </div>
      </div>

      <div class="sig-detail-card">
        <div class="sig-detail-label">CO-PERITO COADYUVANTE</div>
        <div class="sig-field" style="margin-top: 8px;">Nombre: <span class="sig-underline" contenteditable="true" data-field="perito_coadyuvante">{caso.perito_coadyuvante || 'Co-Perito Revisor'}</span></div>
        <div class="sig-field">C.I. N°: <span class="sig-underline" contenteditable="true" data-field="perito_coadyuvante_cedula">{caso.perito_coadyuvante_cedula || 'V-19.888.777'}</span></div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma del Co-Perito Revisor</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR DER.</span></div>
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR IZQ.</span></div>
        </div>
      </div>
    </div>
  </PlanillaFolioWrapper>
</div>
