---
/**
 * SHA256.US — Dictamen Pericial Especializado en Evidencia Fotográfica e Imágenes
 * Fundamentación: ISO/IEC 27042 · Análisis de Metadatos EXIF · Error Level Analysis (ELA).
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">IMÁGENES</div>

    <PlanillaHeader
      title="Dictamen Pericial Especializado en Análisis de Imágenes"
      norma="ISO/IEC 27042 · ANÁLISIS FORENSE EXIF &amp; ELA"
      codigoDoc="FO-IMG-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 IDENTIFICACIÓN DE LA IMAGEN -->
      <div class="section-block">
        <div class="section-heading">1.0 IDENTIFICACIÓN DE LA IMAGEN Y TRAZABILIDAD CRIPTOGRÁFICA</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Archivo de Imagen:</th>
              <td style="width: 75%;">{isBlanco ? <span class="linea-manual"></span> : <span>IMG_20261113_EVIDENCIA_01.jpg (Joint Photographic Experts Group)</span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 de la Imagen:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Resolución y Dimensiones:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>4032 × 3024 píxeles (12.2 MP) · Profundidad de Color: 24 bits sRGB</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 EXTRACCIÓN Y COTEJO EXIF -->
      <div class="section-block">
        <div class="section-heading">2.0 ANÁLISIS DE METADATOS EXIF (EXIFTOOL v12.70 / JPEGSNOOP)</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 30%;">Etiqueta EXIF</th>
              <th style="width: 35%;">Valor Extraído</th>
              <th style="width: 35%;">Conclusión Forense</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Marca y Modelo de Captura (Make/Model)</td>
              <td class="font-mono">{isBlanco ? '' : 'Samsung Galaxy S22 (SM-S901E)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Sensor nativo coincide con el dispositivo consignado.</span>}</td>
            </tr>
            <tr>
              <td>Fecha/Hora Original (DateTimeOriginal)</td>
              <td class="font-mono">{isBlanco ? '' : '2026:11:10 14:22:15'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Marca temporal coherente con el sistema de archivos.</span>}</td>
            </tr>
            <tr>
              <td>Geolocalización GPS (Lat/Long)</td>
              <td class="font-mono">{isBlanco ? '' : '09°55\'41.2"N 69°37\'12.5"W'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Coordenadas coinciden con el lugar de los hechos.</span>}</td>
            </tr>
            <tr>
              <td>Software de Edición (Software Tag)</td>
              <td class="font-mono">{isBlanco ? '' : 'None (Firmware de Cámara Original)'}</td>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Ausencia de software de retoque (Photoshop, GIMP, etc.).</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 ANÁLISIS DE NIVEL DE ERROR ELA -->
      <div class="section-block">
        <div class="section-heading">3.0 ANÁLISIS DE NIVEL DE ERROR DE COMPRESIÓN (ELA) Y PÍXELES</div>
        <div class="field-value" style="font-size: 7.5pt; line-height: 1.35; min-height: 40px;">
          {isBlanco ? (
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <span class="linea-manual"></span>
              <span class="linea-manual"></span>
            </div>
          ) : (
            <span>El análisis ELA revela niveles de tasa de compresión uniformes en toda la superficie de la imagen a 95% de calidad JPEG. No se observan discrepancias lumínicas, artefactos de clonado de píxeles ni inconsistencias en las sombras arrojadas que sugieran manipulación digital.</span>
          )}
        </div>
      </div>

      <!-- 4.0 CONCLUSIONES FORENSES -->
      <div class="legal-clause">
        <strong>4.0 DICTAMEN DE AUTENTICIDAD DE IMAGEN:</strong> Se concluye categóricamente que la fotografía analizada es <strong>AUTÉNTICA E INALTERADA</strong>, conservando su integridad cromática y metadatos de origen desde el instante de su captura digital.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO EN ANÁLISIS DE IMÁGENES"
      peritoTitulo="PERITO COORDINADOR FORENSE"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Co-Perito de Imágenes"
      peritoCedula="V-18.114.908"
      peritoCiv="CIV-289410"
      peritoInpre="INPRE-179420"
      peritoCargo="Especialista en Fotografía Forense"
      rolIso="DES (Digital Evidence Specialist) · ISO 27042"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
