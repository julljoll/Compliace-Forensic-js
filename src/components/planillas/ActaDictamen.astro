---
/**
 * SHA256.US — Dictamen Pericial Oficial de Informática Forense
 * Fundamentación: COPP Arts. 187, 223–225 · ISO/IEC 27042 · LMDFE Art. 4.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 2 Hojas Físicas · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const dictamenNum = caso.numeroCaso ? `D-FOR-${caso.numeroCaso}` : '';
const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <!-- ==================== HOJA 1 DE 2 ==================== -->
  <div class="page">
    <div class="watermark">DICTAMEN PERICIAL</div>

    <PlanillaHeader
      title="Dictamen Pericial Oficial de Informática Forense"
      norma="COPP ARTS. 187, 223–225 · ISO/IEC 27042 · LMDFE ART. 4"
      codigoDoc={dictamenNum || 'FO-DIC-01'}
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={2}
    />

    <div class="planilla-body">
      <!-- 1.0 MARCO NORMATIVO Y FUNDAMENTACIÓN JURÍDICA -->
      <div class="section-block">
        <div class="section-heading">1.0 MARCO NORMATIVO Y FUNDAMENTACIÓN JURÍDICA (COPP ARTS. 187, 223–225)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">COPP Arts. 187, 223, 225:</th>
              <td style="width: 75%;">Garantía de Cadena de Custodia, nombramiento de dos peritos juramentados y motivación científica obligatoria.</td>
            </tr>
            <tr>
              <th>LMDFE Art. 4:</th>
              <td>Plena eficacia y fuerza probatoria de los mensajes de datos, firmas electrónicas y evidencia digital.</td>
            </tr>
            <tr>
              <th>ISO/IEC 27037 &amp; 27042:</th>
              <td>Estándares periciales de repetibilidad científica, reproducibilidad y preservación de copias de trabajo bit-a-bit.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 IDENTIFICACIÓN DE LA EVIDENCIA Y VERIFICACIÓN HASH -->
      <div class="section-block">
        <div class="section-heading">2.0 INDIVIDUALIZACIÓN DE LA EVIDENCIA Y VERIFICACIÓN CRIPTOGRÁFICA</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Dispositivo / Medio Peritado:</th>
              <td style="width: 75%;">{isBlanco ? <span class="linea-manual"></span> : <span>{dispositivoDesc || 'Dispositivo peritado'}</span>}</td>
            </tr>
            <tr>
              <th>Serial Físico / IMEI:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="dispositivo_imei"></span> : <span data-field="dispositivo_imei">{caso.dispositivo_imei || caso.discoduro_serial}</span>}</td>
            </tr>
            <tr>
              <th>PRCC y Precinto de Origen:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="numero_prcc"></span> : <span>PRCC: <span data-field="numero_prcc">{caso.numero_prcc || caso.numeroPRCC}</span> · Precinto: <span data-field="precinto_numero">{caso.precinto_numero}</span></span>}</td>
            </tr>
            <tr>
              <th>Hash Génesis SHA-256 (Original):</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Verificación de Integridad:</th>
              <td style="font-weight: 700;">{isBlanco ? <span>[&nbsp;&nbsp;] MATCH VERIFICADO &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] MISMATCH</span> : <span>[&nbsp;X&nbsp;] MATCH VERIFICADO — 100% CORRESPONDENCIA BIT-A-BIT</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 METODOLOGÍA CIENTÍFICA APLICADA -->
      <div class="section-block">
        <div class="section-heading">3.0 METODOLOGÍA FORENSE Y HERRAMIENTAS HOMOLOGADAS (ISO/IEC 27042)</div>
        <div class="field-value" style="font-size: 7.5pt; line-height: 1.35; min-height: 44px;">
          {isBlanco ? (
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <span class="linea-manual"></span>
              <span class="linea-manual"></span>
            </div>
          ) : (
            <span>Se aplicó clonado bit-a-bit con hardware write-blocker Tableau. El análisis se ejecutó exclusivamente sobre copia forense E01 mediante herramientas validadas por NIST: ALEAPP v3.1.8, Autopsy Forensic Browser v4.21, y entorno Kali Linux aislado de red, asegurando la reproducibilidad total del procedimiento (Estándar Daubert / FRE 702).</span>
          )}
        </div>
      </div>
    </div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={2}
      modo={modo}
    />
  </div>

  <!-- ==================== HOJA 2 DE 2 ==================== -->
  <div class="page">
    <div class="watermark">DICTAMEN PERICIAL</div>

    <PlanillaHeader
      title="Dictamen Pericial Oficial — Conclusiones y Firmas"
      norma="COPP ARTS. 187, 223–225 · ISO/IEC 27042 · LMDFE ART. 4"
      codigoDoc={dictamenNum || 'FO-DIC-01'}
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={2}
      totalHojas={2}
    />

    <div class="planilla-body">
      <!-- 4.0 HALLAZGOS PERICIALES -->
      <div class="section-block">
        <div class="section-heading">4.0 HALLAZGOS PERICIALES Y EVIDENCIA DIGITAL RECUPERADA</div>
        <div class="field-value" style="font-size: 7.5pt; line-height: 1.35; min-height: 60px;">
          {isBlanco ? (
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <span class="linea-manual"></span>
              <span class="linea-manual"></span>
              <span class="linea-manual"></span>
            </div>
          ) : (
            <span>Se constata la existencia de comunicaciones pertinentes en la base de datos msgstore.db, con marcas temporales UTC coherentes, firmas SHA-256 de archivos adjuntos consistentes y sin vestigios de sobreescritura, empalme de bases de datos externas ni adulteración maliciosa en el sistema de archivos peritado.</span>
          )}
        </div>
      </div>

      <!-- 5.0 CONCLUSIONES Y DICTAMEN MOTIVADO -->
      <div class="section-block">
        <div class="section-heading">5.0 CONCLUSIONES TÉCNICO-CIENTÍFICAS Y DICTAMEN MOTIVADO</div>
        <div class="legal-clause" style="margin-bottom: 2px;">
          <strong>DICTAMEN MOTIVADO (COPP ART. 225):</strong> Concluimos de manera unánime, objetiva y fundada en el método científico, que la evidencia digital sometida a peritaje es <strong>AUTÉNTICA, ÍNTEGRA Y FIABLE</strong>. La trazabilidad de su Cadena de Custodia no ha sido vulnerada, cumpliendo a cabalidad con los extremos del Art. 187 del COPP y los estándares periciales ISO/IEC 27037 y 27042.
        </div>
      </div>

      <!-- 6.0 JURAMENTO DE LEY -->
      <div class="legal-clause">
        <strong>6.0 JURAMENTO DE LEY (COPP ART. 223):</strong> Los peritos suscritos juran haber desempeñado su encargo con estricta lealtad a la verdad científica, con independencia de criterio y en sujeción a las normas éticas y legales que rigen el ejercicio de la prueba pericial en la República Bolivariana de Venezuela.
      </div>
    </div>

    <!-- 7.0 CIERRE LEGAL: FIRMAS BILATERALES DE DOS PERITOS -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO INFORMÁTICO FORENSE PRINCIPAL"
      peritoTitulo="CO-PERITO ASISTENTE COADYUVANTE"
      solicitanteNombre={caso.peritoLider || 'Jull Joll (Perito Líder)'}
      solicitanteCedula={caso.perito_cedula || 'V-18.999.001'}
      solicitanteTelefono={caso.solicitante_telefono || '+58 412-0000000'}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre={caso.perito_coadyuvante || 'Co-Perito Acreditado'}
      peritoCedula="V-19.882.110"
      peritoCiv="CIV-301290"
      peritoInpre="INPRE-192014"
      peritoCargo="Perito Coadyuvante en Informática Forense"
      rolIso="DES (Digital Evidence Specialist) · COPP Art. 223"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={2}
      totalHojas={2}
      modo={modo}
    />
  </div>
</div>
