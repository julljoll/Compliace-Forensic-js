---
/**
 * SHA256.US — Acta de Consentimiento Informado, Autorización de Acceso y Hábeas Data
 * Fundamentación: Arts. 28, 48 y 60 CRBV · Ley Especial contra Delitos Informáticos (Arts. 20, 21 y 22)
 * Ley sobre Protección a la Privacidad de las Comunicaciones (Art. 2) · ISO/IEC 27037 §5.2 · NIST SP 800-101.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">CONSENTIMIENTO</div>

    <PlanillaHeader
      title="Acta de Consentimiento Informado y Autorización de Acceso"
      norma="CONSIGNACIÓN PRIVADA · ARTS. 28, 48 Y 60 CRBV · LEDCI ARTS. 20, 21 Y 22 · ISO/IEC 27037"
      codigoDoc="FO-FOR-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 DECLARACIÓN DE LEGITIMACIÓN Y CALIDAD DE INTERLOCUTOR -->
      <div class="section-block">
        <div class="section-heading">1.0 DECLARACIÓN DE LEGITIMACIÓN, TITULARIDAD Y CALIDAD DE INTERLOCUTOR</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 22%;">Apellidos y Nombres:</td>
              <td class="forense-cell-value" style="width: 28%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_nombre"></span> : <span data-field="solicitante_nombre">{caso.solicitante_nombre}</span>}
              </td>
              <td class="forense-cell-label" style="width: 22%;">Cédula de Identidad / RIF:</td>
              <td class="forense-cell-value font-mono" style="width: 28%;">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_cedula"></span> : <span data-field="solicitante_cedula">{caso.solicitante_cedula}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Carácter Jurídico:</td>
              <td class="forense-cell-value">
                {isBlanco ? <span class="linea-manual"></span> : <span>Titular Legítimo / Interlocutor Directo</span>}
              </td>
              <td class="forense-cell-label">Línea Móvil / WhatsApp:</td>
              <td class="forense-cell-value font-mono">
                {isBlanco ? <span class="linea-manual" data-field="solicitante_telefono"></span> : <span data-field="solicitante_telefono">{caso.solicitante_telefono || 'Cuenta WhatsApp Asociada'}</span>}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 AUTORIZACIÓN EXPRESA DE ADQUISICIÓN LÓGICA -->
      <div class="section-block">
        <div class="section-heading">2.0 AUTORIZACIÓN EXPRESA DE ADQUISICIÓN LÓGICA FORENSE (NIST SP 800-101)</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 22%;">Dispositivo Consignado:</td>
              <td class="forense-cell-value" style="width: 28%;">
                {isBlanco ? <span class="linea-manual"></span> : <span>{dispositivoDesc || 'Smartphone consignado voluntariamente'}</span>}
              </td>
              <td class="forense-cell-label" style="width: 22%;">Serial Físico / IMEI:</td>
              <td class="forense-cell-value font-mono" style="width: 28%;">
                {isBlanco ? <span class="linea-manual" data-field="dispositivo_imei"></span> : <span data-field="dispositivo_imei">{caso.dispositivo_imei || caso.discoduro_serial}</span>}
              </td>
            </tr>
            <tr>
              <td class="forense-cell-label">Alcance Técnico:</td>
              <td class="forense-cell-value" colspan="3" style="font-size: 7pt; line-height: 1.25;">
                Adquisición lógica forense (NIST SP 800-101 Nivel 2 · ISO/IEC 27037 §5.4.3) del sistema de archivos y bases de datos SQLite de mensajería (WhatsApp/Telegram: msgstore.db, wa.db), notas de voz, adjuntos multimedia y metadatos cronológicos UTC, con cálculo inmutable de Hash SHA-256.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 EXCLUSIÓN DE ANTIJURIDICIDAD Y PRIVACIDAD -->
      <div class="legal-clause">
        <strong>3.0 EXCLUSIÓN DE ANTIJURIDICIDAD Y PRIVACIDAD DE COMUNICACIONES (CRBV ARTS. 28, 48 Y LEDCI ARTS. 20, 21):</strong> El consignante declara bajo fe de juramento ser el titular legítimo del equipo o interlocutor directo (emisor o receptor) en las comunicaciones peritadas. Otorga autorización libre, informada y expresa para el acceso y extracción lógica de la data pertinente, operando el presente acto como causa de justificación y exclusión de antijuridicidad conforme a los Arts. 20 y 21 de la Ley Especial contra los Delitos Informáticos y Art. 2 de la Ley sobre Protección a la Privacidad de las Comunicaciones, garantizándose la confidencialidad de la información no relacionada con el objeto del peritaje (CRBV Art. 60).
      </div>

      <!-- 4.0 EXENCIÓN DE RESPONSABILIDAD TÉCNICA -->
      <div class="legal-clause">
        <strong>4.0 EXENCIÓN DE RESPONSABILIDAD TÉCNICA:</strong> El laboratorio SHA256.US realiza el peritaje sobre la evidencia tal como fue consignada, sin asumir responsabilidad por datos eliminados, sobrescritos o corrompidos con anterioridad al acto de consignación física formal.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="DECLARANTE / CONSIGNANTE"
      peritoTitulo="RECEPTOR / PERITO OFICIAL SHA256.US"
      solicitanteNombre={caso.solicitante_nombre}
      solicitanteCedula={caso.solicitante_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion={caso.solicitante_direccion}
      peritoNombre={caso.peritoLider}
      peritoCedula={caso.perito_cedula}
      peritoCiv={caso.perito_civ}
      peritoInpre={caso.perito_inpre}
      peritoCargo={caso.perito_cargo}
      rolIso="DEFR · ISO/IEC 27037"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
