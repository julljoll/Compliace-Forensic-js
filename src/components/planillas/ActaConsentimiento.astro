---
/**
 * SHA256.US — Acta de Consentimiento Informado y Autorización de Acceso
 * Arts. 28 y 60 CRBV, ISO/IEC 27037 §5.2. Tamaño Folio (216mm x 330mm).
 */
import PlanillaFolioWrapper from './PlanillaFolioWrapper.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
}

const { caso = {} } = Astro.props;
---

<div class="folio-forense-aislado">
  <PlanillaFolioWrapper
    title="Acta de Consentimiento Informado y Autorización"
    nroLabel="N° EXPEDIENTE:"
    nroValue={caso.numeroCaso || '[EXPEDIENTE]'}
    watermarkText="CONSENTIMIENTO"
  >
    <div class="uswds-top-header">
      ACTA DE CONSENTIMIENTO INFORMADO, AUTORIZACIÓN DE ACCESO Y HÁBEAS DATA — ARTS. 28 Y 60 CRBV, ISO 27037
    </div>

    <!-- BLOQUE EXPEDIENTE / PRCC -->
    <div class="section">
      <div class="uswds-card">
        <div class="grid-container" style="grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <div class="label">Expediente N°</div>
            <div class="value font-mono" contenteditable="true" data-field="numeroCaso">
              {caso.numeroCaso || '[N° Expediente]'}
            </div>
          </div>
          <div class="form-group">
            <div class="label">PRCC N°</div>
            <div class="value font-mono" contenteditable="true" data-field="numero_prcc">
              {caso.numero_prcc || caso.numeroPRCC || '[PRCC-2026-XXXX]'}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 1.0 DECLARACIÓN DE LEGITIMACIÓN -->
    <div class="section">
      <div class="section-title">1.0 DECLARACIÓN DE LEGITIMACIÓN DE POSESIÓN Y TITULARIDAD</div>
      <div class="uswds-card">
        <div class="grid-container" style="grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <div class="label">Apellidos y Nombres</div>
            <div class="value" contenteditable="true" data-field="solicitante_nombre">
              {caso.solicitante_nombre || '[Apellidos y Nombres]'}
            </div>
          </div>
          <div class="form-group">
            <div class="label">Cédula de Identidad / RIF</div>
            <div class="value" contenteditable="true" data-field="solicitante_cedula">
              {caso.solicitante_cedula || '[V- / J-]'}
            </div>
          </div>
          <div class="form-group">
            <div class="label">Carácter con el que actúa</div>
            <div class="value" contenteditable="true">Propietario Legítimo y Usuario Exclusivo</div>
          </div>
          <div class="form-group">
            <div class="label">Empresa / Entidad Solicitante</div>
            <div class="value" contenteditable="true">{caso.organismoOrdenante || 'Consignación Privada'}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2.0 AUTORIZACIÓN EXPRESA -->
    <div class="section">
      <div class="section-title">2.0 AUTORIZACIÓN EXPRESA DE INSPECCIÓN TÉCNICO-PERICIAL</div>
      <div class="uswds-card">
        <div class="grid-container" style="grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-group">
            <div class="label">Marca, Modelo y Tipo</div>
            <div class="value" contenteditable="true">
              {caso.dispositivo_marca ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}` : (caso.discoduro_marca ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}` : '[Marca / Modelo del Dispositivo]')}
            </div>
          </div>
          <div class="form-group">
            <div class="label">Número de Serie / IMEI</div>
            <div class="value font-mono" contenteditable="true" data-field="dispositivo_imei">
              {caso.dispositivo_imei || caso.discoduro_serial || '[IMEI / S/N del Dispositivo]'}
            </div>
          </div>
          <div class="form-group" style="grid-column: span 2;">
            <div class="label">Alcance Autorizado de Inspección</div>
            <div class="value" contenteditable="true">
              Extracción física y lógica, adquisición de imagen forense bit-a-bit (E01/DD), verificación de hash génesis SHA-256 y decodificación pericial de evidencia digital pertinente.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3.0 POLÍTICA DE HÁBEAS DATA -->
    <div class="section">
      <div class="section-title">3.0 POLÍTICA DE HÁBEAS DATA Y PROTECCIÓN DE DATOS SENSIBLES</div>
      <div style="padding: 10px 14px; background-color: #FEFCE8; border-left: 4px solid #D9A700; border-radius: 4px; font-size: 8.5pt; line-height: 1.5; text-align: justify; color: #1B2A4A;">
        El consignante declara bajo fe de juramento ser el titular legítimo o poseer la representación legal debidamente acreditada sobre la evidencia digital descrita. Autoriza voluntariamente al laboratorio privado SHA256.US a realizar la extracción, clonación bit a bit y peritaje forense de los contenidos digitales dentro del alcance delimitado, eximiendo al laboratorio de cualquier responsabilidad derivada del tratamiento legítimo de los datos en cumplimiento del encargo.
      </div>
    </div>

    <!-- 4.0 EXENCIÓN DE RESPONSABILIDAD -->
    <div class="section">
      <div class="section-title">4.0 EXENCIÓN DE RESPONSABILIDAD LEGAL Y ALCANCE PERICIAL</div>
      <div style="padding: 10px 14px; background-color: #F0FDF4; border-left: 4px solid #008837; border-radius: 4px; font-size: 8.5pt; line-height: 1.5; text-align: justify; color: #1B2A4A;">
        Las partes acuerdan que las actividades de extracción, decodificación e inspección forense se circunscriben estrictamente a la búsqueda de evidencia digital pertinente. SHA256.US no asume responsabilidad por la existencia previa de archivos dañados o datos borrados antes de la consignación.
      </div>
    </div>

    <!-- 5.0 FIRMAS Y REGISTRO DACTILAR -->
    <div class="signature-section" style="page-break-before: auto; padding-top: 10px;">
      <!-- Declarante / Consignante -->
      <div class="sig-detail-card">
        <div class="sig-detail-label">DECLARANTE / CONSIGNANTE</div>
        <div class="sig-field" style="margin-top: 8px;">
          Nombre: <span class="sig-underline" contenteditable="true" data-field="solicitante_nombre">{caso.solicitante_nombre || '[Nombre del Declarante]'}</span>
        </div>
        <div class="sig-field">
          C.I. N°: <span class="sig-underline" contenteditable="true" data-field="solicitante_cedula">{caso.solicitante_cedula || '[Cédula de Identidad]'}</span>
        </div>
        <div class="sig-field">
          Teléfono: <span class="sig-underline" contenteditable="true" data-field="solicitante_telefono">{caso.solicitante_telefono || '[Número Telefónico]'}</span>
        </div>
        <div class="sig-field">
          Dirección: <span class="sig-underline" contenteditable="true" data-field="solicitante_direccion">{caso.solicitante_direccion || '[Dirección de Habitación]'}</span>
        </div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma del Declarante Consignante</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper">
            <div class="thumb-box"></div>
            <span class="thumb-label">PULGAR DER.</span>
          </div>
          <div class="thumb-wrapper">
            <div class="thumb-box"></div>
            <span class="thumb-label">PULGAR IZQ.</span>
          </div>
        </div>
      </div>

      <!-- Receptor / Perito SHA256.US -->
      <div class="sig-detail-card">
        <div class="sig-detail-label">RECEPTOR / PERITO OFICIAL SHA256.US</div>
        <div class="sig-field" style="margin-top: 8px;">
          Nombre: <span class="sig-underline" contenteditable="true" data-field="peritoLider">{caso.peritoLider || '[Nombre y Apellido del Perito]'}</span>
        </div>
        <div class="sig-field">
          C.I. N°: <span class="sig-underline" contenteditable="true" data-field="perito_cedula">{caso.perito_cedula || 'V-18.999.001'}</span>
        </div>
        <div class="sig-field">
          CIV N°: <span class="sig-underline" contenteditable="true" data-field="perito_civ">{caso.perito_civ || 'CIV-299410'}</span>
        </div>
        <div class="sig-field">
          INPREABOGADO N°: <span class="sig-underline" contenteditable="true" data-field="perito_inpre">{caso.perito_inpre || 'INPRE-184920'}</span>
        </div>
        <div class="sig-field">
          Cargo: <span class="sig-underline" contenteditable="true" data-field="perito_cargo">{caso.perito_cargo || 'Perito Informático Forense'}</span>
        </div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma del Perito Receptor</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper">
            <div class="thumb-box"></div>
            <span class="thumb-label">PULGAR DER.</span>
          </div>
          <div class="thumb-wrapper">
            <div class="thumb-box"></div>
            <span class="thumb-label">PULGAR IZQ.</span>
          </div>
        </div>
        <div style="font-size: 8px; text-align: center; margin-top: 6px; color: #0F172A; font-weight: bold;">
          Rol ISO/IEC 27037: [&nbsp;X&nbsp;] DEFR (Adquisición &amp; Imagen Forense) &nbsp;&nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] DES
        </div>
      </div>
    </div>
  </PlanillaFolioWrapper>
</div>
