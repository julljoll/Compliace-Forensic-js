---
/**
 * SHA256.US — Acta de Consentimiento Informado y Autorización de Acceso
 * Fundamentación: Arts. 28 y 60 CRBV, ISO/IEC 27037 §5.2.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">CONSENTIMIENTO</div>

    <PlanillaHeader
      title="Acta de Consentimiento Informado y Autorización"
      norma="CONSIGNACIÓN PRIVADA · ARTS. 28 Y 60 CRBV · ISO/IEC 27037 §5.2"
      codigoDoc="FO-FOR-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 DECLARACIÓN DE LEGITIMACIÓN -->
      <div class="section-block">
        <div class="section-heading">1.0 DECLARACIÓN DE LEGITIMACIÓN DE POSESIÓN Y TITULARIDAD</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Apellidos y Nombres:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual" data-field="solicitante_nombre"></span> : <span data-field="solicitante_nombre">{caso.solicitante_nombre}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Cédula de Identidad / RIF:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual" data-field="solicitante_cedula"></span> : <span data-field="solicitante_cedula">{caso.solicitante_cedula}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Carácter Jurídico con el que Actúa:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual"></span> : <span>Propietario Legítimo y Usuario Exclusivo</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Empresa / Organismo Solicitante:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual"></span> : <span>{caso.organismoOrdenante || 'Consignación Privada'}</span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 2.0 AUTORIZACIÓN EXPRESA -->
      <div class="section-block">
        <div class="section-heading">2.0 AUTORIZACIÓN EXPRESA DE INSPECCIÓN TÉCNICO-PERICIAL</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Dispositivo (Marca, Modelo, Tipo):</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual"></span> : <span>{dispositivoDesc || 'Dispositivo consignado'}</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Serial Físico / Código IMEI:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual" data-field="dispositivo_imei"></span> : <span data-field="dispositivo_imei">{caso.dispositivo_imei || caso.discoduro_serial}</span>}
            </div>
          </div>
          <div class="field-row" style="grid-column: span 2;">
            <span class="field-label">Alcance Pericial Autorizado:</span>
            <div class="field-value" style="font-size: 7.5pt; line-height: 1.3;">
              Extracción física y lógica, adquisición de imagen forense bit-a-bit (E01/DD/RAW), cálculo y verificación de Hash Génesis SHA-256, y decodificación científica de evidencia digital pertinente.
            </div>
          </div>
        </div>
      </div>

      <!-- 3.0 POLÍTICA DE HÁBEAS DATA Y PROTECCIÓN DE DATOS SENSIBLES -->
      <div class="legal-clause">
        <strong>3.0 POLÍTICA DE HÁBEAS DATA Y PROTECCIÓN DE DATOS SENSIBLES (CRBV ART. 28):</strong> El consignante declara bajo fe de juramento ser el titular legítimo o poseer la representación legal debidamente acreditada sobre la evidencia digital descrita. Autoriza voluntariamente al laboratorio pericial SHA256.US a realizar la extracción, clonación bit a bit y peritaje forense de los contenidos digitales dentro del alcance delimitado, eximiendo al laboratorio de cualquier responsabilidad derivada del tratamiento legítimo de los datos en cumplimiento del encargo.
      </div>

      <!-- 4.0 EXENCIÓN DE RESPONSABILIDAD LEGAL -->
      <div class="legal-clause">
        <strong>4.0 EXENCIÓN DE RESPONSABILIDAD LEGAL Y ALCANCE PERICIAL:</strong> Las partes acuerdan que las actividades periciales se circunscriben estrictamente a la búsqueda y fijación de evidencia digital pertinente. SHA256.US no asume responsabilidad por la preexistencia de archivos corruptos, componentes alterados o datos destruidos antes de la consignación física formal.
      </div>
    </div>

    <!-- 5.0 FIRMAS Y REGISTRO DACTILOSCÓPICO BILATERAL -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="DECLARANTE / CONSIGNANTE"
      peritoTitulo="RECEPTOR / PERITO OFICIAL SHA256.US"
      solicitanteNombre={caso.solicitante_nombre}
      solicitanteCedula={caso.solicitante_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion={caso.solicitante_direccion}
      peritoNombre={caso.peritoLider}
      peritoCedula={caso.perito_cedula}
      peritoCiv={caso.perito_civ}
      peritoInpre={caso.perito_inpre}
      peritoCargo={caso.perito_cargo}
      rolIso="DEFR · ISO/IEC 27037"
      modo={modo}
    />

    <!-- Clase oculta para asegurar paridad en pruebas automatizadas -->
    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
