---
/**
 * SHA256.US — Dictamen Pericial de Autenticidad de Audios Digitales
 * Decodificación Opus, Espectrograma FFT, SWGDE & Daubert. Tamaño Folio (216mm x 330mm).
 */
import PlanillaFolioWrapper from './PlanillaFolioWrapper.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
}

const { caso = {} } = Astro.props;
const dictamenNum = caso.numeroCaso ? `D-AUD-${caso.numeroCaso}` : 'D-AUD-2026-0091';
---

<div class="folio-forense-aislado">
  <PlanillaFolioWrapper
    title="Dictamen Pericial de Audios Digitales"
    nroLabel="N° DICTAMEN:"
    nroValue={dictamenNum}
    watermarkText="DICTAMEN AUDIO OPUS"
  >
    <div class="uswds-top-header">
      DICTAMEN PERICIAL ACÚSTICO FORENSE — DECODIFICACIÓN OPUS 48 kHz · ESPECTROGRAMA FFT · SWGDE · DAUBERT FRE 702
    </div>

    <!-- ENCABEZADO -->
    <div class="section">
      <div class="section-title">1.0 MARCO NORMATIVO Y OBJETO PERICIAL</div>
      <div class="uswds-card">
        <div class="grid-container" style="grid-template-columns: 1fr 1fr; gap: 8px;">
          <div class="form-group">
            <div class="label">N° Expediente</div>
            <div class="value font-mono" contenteditable="true" data-field="numeroCaso">{caso.numeroCaso || '[EXPEDIENTE]'}</div>
          </div>
          <div class="form-group">
            <div class="label">Perito en Acústica Forense</div>
            <div class="value" contenteditable="true" data-field="peritoLider">{caso.peritoLider || 'Perito Acústico'}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ESPECIFICACIÓN DEL AUDIO -->
    <div class="section">
      <div class="section-title">2.0 ESPECIFICACIÓN TÉCNICA DEL ARCHIVO OPUS Y HASH SHA-256</div>
      <table style="width: 100%; border-collapse: collapse; border: 1px solid #CBD5E1; font-size: 8.5pt;">
        <tbody>
          <tr style="border-bottom: 1px solid #CBD5E1;">
            <td style="padding: 6px 8px; width: 35%; font-weight: 700; background: #F8FAFC;">Formato Original</td>
            <td style="padding: 6px 8px;" contenteditable="true">Contenedor OGG con flujo de audio Opus (RFC 6716) @ 48,000 Hz</td>
          </tr>
          <tr style="border-bottom: 1px solid #CBD5E1;">
            <td style="padding: 6px 8px; font-weight: 700; background: #F8FAFC;">Análisis de Espectrograma</td>
            <td style="padding: 6px 8px;" contenteditable="true">Continuidad de armónicos en formantes F1, F2 y F3 sin cortes bruscos.</td>
          </tr>
          <tr style="border-bottom: 1px solid #CBD5E1;">
            <td style="padding: 6px 8px; font-weight: 700; background: #F8FAFC;">Verificación Anti-Deepfake</td>
            <td style="padding: 6px 8px; color: #008837; font-weight: 700;" contenteditable="true">Conforme (Voz biológica auténtica, algoritmo Yin comprobado)</td>
          </tr>
          <tr>
            <td style="padding: 6px 8px; font-weight: 700; background: #F8FAFC;">Hash SHA-256 del Audio</td>
            <td style="padding: 6px 8px;" class="font-mono" contenteditable="true" data-field="hashSHA256">{caso.hashSHA256 || '[Hash SHA-256 del audio]'}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- CONCLUSIÓN -->
    <div class="section">
      <div class="section-title">3.0 CONCLUSIONES ACÚSTICO-PERICIALES</div>
      <div class="form-group" contenteditable="true" style="min-height: 120px; border: 1px solid #CBD5E1; border-radius: 4px; padding: 10px; font-size: 8.5pt; line-height: 20px; background: #FFFFFF;">
        Se concluye que el audio analizado es auténtico e íntegro, no presenta vestigios de edición, corte ni empalme temporal. La señal acústica es consistente con la voz humana emitida directamente a través del transductor del teléfono peritado.
      </div>
    </div>

    <!-- FIRMAS BILATERALES -->
    <div class="signature-section" style="padding-top: 10px;">
      <div class="sig-detail-card">
        <div class="sig-detail-label">PERITO EN ACÚSTICA</div>
        <div class="sig-field" style="margin-top: 8px;">Nombre: <span class="sig-underline" contenteditable="true" data-field="peritoLider">{caso.peritoLider || 'Perito Principal'}</span></div>
        <div class="sig-field">C.I. N°: <span class="sig-underline" contenteditable="true" data-field="perito_cedula">{caso.perito_cedula || 'V-18.999.001'}</span></div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma del Especialista</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR DER.</span></div>
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR IZQ.</span></div>
        </div>
      </div>

      <div class="sig-detail-card">
        <div class="sig-detail-label">CO-PERITO ASISTENTE</div>
        <div class="sig-field" style="margin-top: 8px;">Nombre: <span class="sig-underline" contenteditable="true" data-field="perito_coadyuvante">{caso.perito_coadyuvante || 'Co-Perito Informático'}</span></div>
        <div class="sig-field">C.I. N°: <span class="sig-underline" contenteditable="true" data-field="perito_coadyuvante_cedula">{caso.perito_coadyuvante_cedula || 'V-19.888.777'}</span></div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma de Conformidad</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR DER.</span></div>
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR IZQ.</span></div>
        </div>
      </div>
    </div>
  </PlanillaFolioWrapper>
</div>
