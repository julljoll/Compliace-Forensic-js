---
/**
 * SHA256.US — Acta de Desprecintado, Apertura y Adquisición Lógica en Laboratorio
 * Fundamentación: ISO/IEC 27037 §5.4.3 · NIST SP 800-101 Nivel 2 · COPP Art. 187 · LMDFE Art. 7.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">DESPRECINTADO</div>

    <PlanillaHeader
      title="Acta de Desprecintado y Adquisición Lógica en Laboratorio"
      norma="ISO/IEC 27037 §5.4.3 · NIST SP 800-101 NIVEL 2 · COPP ART. 187"
      codigoDoc="FO-FOR-04"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 CONDICIONES DE APERTURA -->
      <div class="section-block">
        <div class="section-heading">1.0 DATOS DE APERTURA Y MEDIO CONTROLADO DE LABORATORIO</div>
        <table class="forense-cell-table">
          <tbody>
            <tr>
              <td class="forense-cell-label" style="width: 25%;">Lugar de Apertura:</td>
              <td class="forense-cell-value" style="width: 35%;">
                {isBlanco ? <span class="linea-manual"></span> : <span>Área Pericial Aislada — Laboratorio SHA256.US</span>}
              </td>
              <td class="forense-cell-label" style="width: 20%;">Fecha y Hora:</td>
              <td class="forense-cell-value font-mono" style="width: 20%;">
                {isBlanco ? <span class="linea-manual"></span> : <span>{new Date().toLocaleDateString('es-VE')} · 11:30 VET</span>}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 VERIFICACIÓN PREVIA DEL PRECINTO Y NUEVO PRECINTO -->
      <div class="section-block">
        <div class="section-heading">2.0 TRAZABILIDAD DE PRECINTOS: INICIAL Y REEMBALAJE (MUCC-2017)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 28%;">Dispositivo Móvil:</th>
              <td style="width: 72%;">{isBlanco ? <span class="linea-manual"></span> : <span>{dispositivoDesc || 'Smartphone'} (S/N o IMEI: {caso.dispositivo_imei || caso.discoduro_serial || 'N/A'})</span>}</td>
            </tr>
            <tr>
              <th>Precinto Inicial Roto N°:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="precinto_numero"></span> : <span data-field="precinto_numero">{caso.precinto_numero || 'PREC-2026-991'}</span>}</td>
            </tr>
            <tr>
              <th>Estado Físico del Precinto:</th>
              <td>{isBlanco ? <span>[&nbsp;&nbsp;] Íntegro sin apertura previa &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] Dañado / Violado</span> : <span>[&nbsp;X&nbsp;] ÍNTEGRO, SIN SIGNOS DE APERTURA PREVIA NI ADULTERACIÓN</span>}</td>
            </tr>
            <tr>
              <th>Nuevo Precinto de Reembalaje N°:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>PREC-REEMB-2026-992 (Asignado tras extracción)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 PROCEDIMIENTO DE ADQUISICIÓN LÓGICA Y HASH -->
      <div class="section-block">
        <div class="section-heading">3.0 ADQUISICIÓN LÓGICA FORENSE Y CÁLCULO DE HASH (NIST SP 800-101)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 32%;">Modalidad de Adquisición:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Extracción Lógica de Contenedor y Bases de Datos SQLite (NIST Nivel 2)</span>}</td>
            </tr>
            <tr>
              <th>Herramienta Forense Empleada:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>ALEAPP CLI / Andriller / Protocolo de Respaldo Lógico Auditado</span>}</td>
            </tr>
            <tr>
              <th>Base de Datos Extraída:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>msgstore.db / wa.db (Comunicaciones de WhatsApp)</span>}</td>
            </tr>
            <tr>
              <th>Hash SHA-256 de la Base de Datos:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Verificación de Integridad:</th>
              <td style="font-weight: 700;">{isBlanco ? <span>[&nbsp;&nbsp;] MATCH (100% ÍNTEGRO) &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] MISMATCH (ALERTA)</span> : <span>[&nbsp;X&nbsp;] MATCH (100% ÍNTEGRO — VALIDEZ DE ORIGINAL ART. 7 LMDFE)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 4.0 REEMBALAJE Y RESGUARDO -->
      <div class="legal-clause">
        <strong>4.0 CONSTANCIA DE REEMBALAJE Y RESGUARDO (MUCC-2017):</strong> Culminada con éxito la extracción lógica forense de la base de datos de mensajería y calculado su Hash SHA-256, se reembaló el teléfono celular original en bolsa Faraday y se le aplicó el Nuevo Precinto de Seguridad supra registrado, garantizando su indemnidad para posterior cotejo o devolución formal.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO EXTRACTOR / ADQUISIDOR"
      peritoTitulo="CO-PERITO DE CONTROL DE CALIDAD"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Co-Perito Revisor"
      peritoCedula="V-19.882.110"
      peritoCiv="CIV-301290"
      peritoInpre="INPRE-192014"
      peritoCargo="Especialista en Adquisición Lógica"
      rolIso="DEFR / DES · ISO/IEC 27037"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
