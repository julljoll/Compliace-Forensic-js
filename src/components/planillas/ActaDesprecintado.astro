---
/**
 * SHA256.US — Acta de Desprecintado y Apertura en Laboratorio
 * Fundamentación: ISO/IEC 27037 §5.4 · NIST SP 800-86 · COPP Art. 187.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const dispositivoDesc = caso.dispositivo_marca
  ? `${caso.dispositivo_marca} ${caso.dispositivo_modelo || ''}`
  : caso.discoduro_marca
    ? `${caso.discoduro_marca} ${caso.discoduro_modelo || ''}`
    : '';
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">DESPRECINTADO</div>

    <PlanillaHeader
      title="Acta de Desprecintado y Apertura en Laboratorio"
      norma="ISO/IEC 27037 §5.4 · NIST SP 800-86 · COPP ART. 187"
      codigoDoc="FO-FOR-04"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 CONDICIONES DE APERTURA -->
      <div class="section-block">
        <div class="section-heading">1.0 DATOS DE APERTURA Y MEDIO CONTROLADO DE LABORATORIO</div>
        <div class="form-grid-2">
          <div class="field-row">
            <span class="field-label">Lugar de Apertura:</span>
            <div class="field-value">
              {isBlanco ? <span class="linea-manual"></span> : <span>Área Pericial Limpia — Laboratorio Forense SHA256.US</span>}
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Fecha y Hora de Ruptura de Precinto:</span>
            <div class="field-value font-mono">
              {isBlanco ? <span class="linea-manual"></span> : <span>{new Date().toLocaleDateString('es-VE')} - 11:30 AM</span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 2.0 VERIFICACIÓN PREVIA DEL PRECINTO -->
      <div class="section-block">
        <div class="section-heading">2.0 INSPECCIÓN Y VERIFICACIÓN PREVIA DE INTEGRIDAD FÍSICA (COPP ART. 187)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Dispositivo a Desprecintar:</th>
              <td style="width: 75%;">{isBlanco ? <span class="linea-manual"></span> : <span>{dispositivoDesc || 'Dispositivo peritado'} (S/N: {caso.dispositivo_imei || caso.discoduro_serial || 'N/A'})</span>}</td>
            </tr>
            <tr>
              <th>Precinto Inicial N°:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="precinto_numero"></span> : <span data-field="precinto_numero">{caso.precinto_numero || 'PREC-2026-991'}</span>}</td>
            </tr>
            <tr>
              <th>Estado Físico del Precinto:</th>
              <td>{isBlanco ? <span>[&nbsp;&nbsp;] Íntegro sin signos de apertura previa &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] Dañado / Adulterado</span> : <span>[&nbsp;X&nbsp;] ÍNTEGRO, SIN SIGNOS DE APERTURA PREVIA NI ADULTERACIÓN</span>}</td>
            </tr>
            <tr>
              <th>Bolsa Faraday Receptora:</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="bolsa_faraday_numero"></span> : <span data-field="bolsa_faraday_numero">{caso.bolsa_faraday_numero || 'FARADAY-2026-001'}</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 3.0 PROCEDIMIENTO DE ADQUISICIÓN Y HASH MATCH -->
      <div class="section-block">
        <div class="section-heading">3.0 ADQUISICIÓN BIT-A-BIT Y CÁLCULO DE HASH GÉNESIS (NIST SP 800-86)</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 30%;">Bloqueador de Escritura:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>Tableau Forensic T8u USB 3.0 Bridge (Hardware Write-Blocker Certificado)</span>}</td>
            </tr>
            <tr>
              <th>Herramienta de Clonación:</th>
              <td>{isBlanco ? <span class="linea-manual"></span> : <span>FTK Imager CLI / dc3dd v7.2 (Modo Forense E01 con compresión gzip)</span>}</td>
            </tr>
            <tr>
              <th>Hash Génesis SHA-256 (Origen):</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual" data-field="hashSHA256"></span> : <span data-field="hashSHA256">{caso.hashSHA256 || 'Pendiente por cálculo'}</span>}</td>
            </tr>
            <tr>
              <th>Hash Imagen Forense (Destino):</th>
              <td class="font-mono">{isBlanco ? <span class="linea-manual"></span> : <span>{caso.hashSHA256 || 'Pendiente por verificación'}</span>}</td>
            </tr>
            <tr>
              <th>Resultado de Verificación:</th>
              <td style="font-weight: 700;">{isBlanco ? <span>[&nbsp;&nbsp;] MATCH (100% IDÉNTICO) &nbsp;&nbsp;&nbsp; [&nbsp;&nbsp;] MISMATCH (ALERTA)</span> : <span>[&nbsp;X&nbsp;] MATCH (100% IDÉNTICO — INTEGRIDAD BIT-A-BIT CERTIFICADA)</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 4.0 DECLARACIÓN DE RESGUARDO -->
      <div class="legal-clause">
        <strong>4.0 DECLARACIÓN DE INTEGRIDAD FORENSE:</strong> Constatada la correspondencia matemática unívoca entre el Hash Génesis del medio físico y la Imagen Forense adquirida, se procede a reembalar el medio original, aplicándole nuevo precinto de seguridad, para trabajar exclusivamente sobre copia de trabajo pericial certificada, garantizando la inmutabilidad procesal de la prueba.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO EXTRACTOR / ADQUISIDOR"
      peritoTitulo="CO-PERITO DE CONTROL DE CALIDAD"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Co-Perito Revisor"
      peritoCedula="V-19.882.110"
      peritoCiv="CIV-301290"
      peritoInpre="INPRE-192014"
      peritoCargo="Especialista en Adquisición Digital"
      rolIso="DEFR / DES · ISO/IEC 27037"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
