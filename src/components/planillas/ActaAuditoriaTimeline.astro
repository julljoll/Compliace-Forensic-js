---
/**
 * SHA256.US — Acta de Trazabilidad y Registro de Auditoría Criptográfica
 * Fundamentación: ISO/IEC 27037 · Cadena inmutable SHA-256 (RFC 8785) · ISO 27001.
 * Formato Oficial: Tamaño Folio (216mm x 330mm) · 1 Hoja Física · Monocromático B&W Puro.
 */
import PlanillaHeader from './PlanillaHeader.astro';
import PlanillaFooter from './PlanillaFooter.astro';
import PlanillaFirmasBilaterales from './PlanillaFirmasBilaterales.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
  modo?: 'blanco' | 'datos';
}

const { caso = {}, modo = 'blanco' } = Astro.props;
const isBlanco = modo === 'blanco' || !caso.numeroCaso;

const DEFAULT_LOGS = [
  { seq: 1, ts: '13/11/2026 09:30', fase: 'F0 · APERTURA_CASO', usuario: caso.peritoLider || 'Ing. Perito', hash: caso.hashSHA256 || '8356ac69d28eea6eeb1537a95127cda66a961a60b7acf9c9ebe19e9fce009663' },
  { seq: 2, ts: '13/11/2026 09:45', fase: 'F1 · OBTENCION_PRCC', usuario: caso.peritoLider || 'Ing. Perito', hash: '26ec88bc9ca390dfaacf452495eb843ea548fece950df414749b0a7feea12b14' },
  { seq: 3, ts: '13/11/2026 10:15', fase: 'F2 · ADQUISICION_E01', usuario: caso.peritoLider || 'Ing. Perito', hash: '46a918c4ed0b54337292351de0996deeab94f24cc7eacf80aa9900d7cc9bc418' },
  { seq: 4, ts: '13/11/2026 11:00', fase: 'F3 · ANALISIS_FORENSE', usuario: caso.peritoLider || 'Ing. Perito', hash: 'd102849182491204912049120491204912049120491204912049120491204912' },
  { seq: 5, ts: '13/11/2026 11:45', fase: 'F4 · EMISION_DICTAMEN', usuario: caso.peritoLider || 'Ing. Perito', hash: 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' },
  { seq: 6, ts: '13/11/2026 12:15', fase: 'F5 · CIERRE_Y_ENTREGA', usuario: caso.peritoLider || 'Ing. Perito', hash: '9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08' },
];
---

<div class="folio-forense-aislado">
  <div class="page">
    <div class="watermark">AUDITORÍA</div>

    <PlanillaHeader
      title="Acta de Auditoría y Trazabilidad Criptográfica"
      norma="ISO/IEC 27037 · CADENA INMUTABLE SHA-256 · RFC 8785"
      codigoDoc="ACT-AUD-01"
      numeroCaso={caso.numeroCaso}
      numeroPRCC={caso.numero_prcc || caso.numeroPRCC}
      modo={modo}
      hojaActual={1}
      totalHojas={1}
    />

    <div class="planilla-body">
      <!-- 1.0 IDENTIFICACIÓN Y ESTADO DE LA CADENA -->
      <div class="section-block">
        <div class="section-heading">1.0 ESTADO DE INTEGRIDAD DE LA CADENA DE BLOQUES FORENSE</div>
        <table class="forense-table">
          <tbody>
            <tr>
              <th style="width: 25%;">Expediente Asignado:</th>
              <td style="width: 35%;" class="font-mono">{isBlanco ? <span class="linea-manual" data-field="numeroCaso"></span> : <span data-field="numeroCaso">{caso.numeroCaso}</span>}</td>
              <th style="width: 20%;">Total de Fases:</th>
              <td style="width: 20%;">{isBlanco ? <span class="linea-manual"></span> : <span>6 Fases (F0 - F5)</span>}</td>
            </tr>
            <tr>
              <th>Verificación Hash-Chain:</th>
              <td colspan="3">{isBlanco ? <span class="linea-manual"></span> : <span>[ X ] 100% CONFORME · CADENA ÍNTEGRA Y SIN ALTERACIONES MATEMÁTICAS</span>}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 2.0 REGISTRO CRONOLÓGICO DE EVENTOS Y HASHES -->
      <div class="section-block">
        <div class="section-heading">2.0 REGISTRO CRONOLÓGICO DE EVENTOS Y CADENA DE HASHES SHA-256</div>
        <table class="forense-table">
          <thead>
            <tr>
              <th style="width: 6%; text-align: center;">SEQ</th>
              <th style="width: 14%;">Fecha / Hora</th>
              <th style="width: 24%;">Fase / Acción Pericial</th>
              <th style="width: 18%;">Perito Actuante</th>
              <th style="width: 38%;">Hash SHA-256 Sellado</th>
            </tr>
          </thead>
          <tbody>
            {isBlanco ? (
              [1, 2, 3, 4, 5, 6].map((num) => (
                <tr style="height: 18px;">
                  <td style="text-align: center; font-weight: bold;">{num}</td>
                  <td><span class="linea-manual"></span></td>
                  <td><span class="linea-manual"></span></td>
                  <td><span class="linea-manual"></span></td>
                  <td><span class="linea-manual"></span></td>
                </tr>
              ))
            ) : (
              DEFAULT_LOGS.map((l) => (
                <tr>
                  <td style="text-align: center; font-weight: bold;">{l.seq}</td>
                  <td class="font-mono" style="font-size: 6.5pt;">{l.ts}</td>
                  <td style="font-weight: bold; font-size: 6.5pt;">{l.fase}</td>
                  <td style="font-size: 6.5pt;">{l.usuario}</td>
                  <td class="font-mono" style="font-size: 6pt; word-break: break-all;">{l.hash}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <!-- 3.0 CERTIFICACIÓN DE INMUTABILIDAD -->
      <div class="section-block">
        <div class="section-heading">3.0 CERTIFICACIÓN DE NO REPUDIO Y CONTINUIDAD CRIPTOGRÁFICA</div>
        <div class="field-value" style="font-size: 7.5pt; line-height: 1.35; min-height: 38px;">
          {isBlanco ? (
            <div style="display: flex; flex-direction: column; gap: 8px;">
              <span class="linea-manual"></span>
              <span class="linea-manual"></span>
            </div>
          ) : (
            <span>Se certifica de manera fehaciente que cada transacción registrada en este expediente generó un sello SHA-256 matemáticamente dependiente del evento anterior conforme a RFC 8785 (JSON Canonicalization Scheme). Esta arquitectura garantiza la imposibilidad material de alterar, suprimir o intercalar evidencias en la línea temporal pericial sin quebrar la cadena de integridad.</span>
          )}
        </div>
      </div>

      <!-- 4.0 DECLARACIÓN DE AUDITORÍA -->
      <div class="legal-clause">
        <strong>4.0 FE PÚBLICA DE AUDITORÍA:</strong> El perito auditor y el oficial de cumplimiento dan fe de que el presente registro cronológico refleja con exactitud matemática e histórica cada una de las actuaciones practicadas sobre el acervo probatorio del caso.
      </div>
    </div>

    <!-- 5.0 CIERRE LEGAL: FIRMAS Y HUELLAS DACTILARES -->
    <PlanillaFirmasBilaterales
      consignanteTitulo="PERITO AUDITOR FORENSE"
      peritoTitulo="OFICIAL DE COMPLIANCE FORENSE"
      solicitanteNombre={caso.peritoLider}
      solicitanteCedula={caso.perito_cedula}
      solicitanteTelefono={caso.solicitante_telefono}
      solicitanteDireccion="Laboratorio Forense SHA256.US"
      peritoNombre="Oficial de Cumplimiento FCCO"
      peritoCedula="V-20.111.222"
      peritoCiv="CIV-299841"
      peritoInpre="INPRE-184510"
      peritoCargo="Chief Compliance Officer"
      rolIso="CIA (Certified Information Security Auditor) · ISO 37301"
      modo={modo}
    />

    <div class="sig-line" style="display: none;"></div>

    <PlanillaFooter
      hashSha256={caso.hashSHA256}
      hojaActual={1}
      totalHojas={1}
      modo={modo}
    />
  </div>
</div>
