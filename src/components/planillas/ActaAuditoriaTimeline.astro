---
/**
 * SHA256.US — Acta de Trazabilidad y Registro de Auditoría Criptográfica
 * Cadena inmutable SHA-256 (ISO/IEC 27037 & ISO 27001). Tamaño Folio (216mm x 330mm).
 */
import PlanillaFolioWrapper from './PlanillaFolioWrapper.astro';
import type { CasoCMS } from '../../lib/domain/types';

interface Props {
  caso?: Partial<CasoCMS>;
}

const { caso = {} } = Astro.props;

const DEFAULT_LOGS = [
  { seq: 1, ts: '13/11/2026 09:30:15', accion: 'RECEPCION_EVIDENCIA', usuario: 'Ing. Carlos Perito', hash: '8356ac69d28eea6eeb1537a95127cda66a961a60b7acf9c9ebe19e9fce009663' },
  { seq: 2, ts: '13/11/2026 09:45:00', accion: 'APERTURA_PRCC', usuario: 'Ing. Carlos Perito', hash: '26ec88bc9ca390dfaacf452495eb843ea548fece950df414749b0a7feea12b14' },
  { seq: 3, ts: '13/11/2026 10:15:30', accion: 'ADQUISICION_E01', usuario: 'Ing. Carlos Perito', hash: '46a918c4ed0b54337292351de0996deeab94f24cc7eacf80aa9900d7cc9bc418' },
  { seq: 4, ts: '13/11/2026 11:00:12', accion: 'ANALISIS_FORENSE', usuario: 'Ing. Carlos Perito', hash: 'd102849182491204912049120491204912049120491204912049120491204912' },
  { seq: 5, ts: '13/11/2026 11:45:00', accion: 'SELLADO_FASE_F4', usuario: 'Ing. Carlos Perito', hash: 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' },
];
---

<div class="folio-forense-aislado">
  <PlanillaFolioWrapper
    title="Acta de Auditoría y Trazabilidad Criptográfica"
    nroLabel="N° EXPEDIENTE:"
    nroValue={caso.numeroCaso || '[EXPEDIENTE]'}
    watermarkText="AUDITORÍA"
  >
    <div class="uswds-top-header">
      ACTA DE TRAZABILIDAD Y REGISTRO DE AUDITORÍA CRIPTOGRÁFICA — LOGS EN CADENA SHA-256 (ISO 27001 · COPP)
    </div>

    <!-- EXPEDIENTE Y RESUMEN -->
    <div class="section">
      <div class="uswds-card">
        <div class="grid-container" style="grid-template-columns: 1fr 1fr; gap: 8px;">
          <div class="form-group">
            <div class="label">Expediente N°</div>
            <div class="value font-mono" contenteditable="true" data-field="numeroCaso">{caso.numeroCaso || '[N° Expediente]'}</div>
          </div>
          <div class="form-group">
            <div class="label">Estado de la Cadena Hash</div>
            <div class="value font-mono" style="color: #008837; font-weight: 700;">100% ÍNTEGRA / SIN ALTERACIONES</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 1.0 TABLA DE LOGS CRIPTOGRÁFICOS -->
    <div class="section">
      <div class="section-title">1.0 REGISTRO CRONOLÓGICO DE EVENTOS Y HASH-CHAIN SHA-256</div>
      <table style="width: 100%; border-collapse: collapse; border: 1px solid #CBD5E1; font-size: 7.5pt;">
        <thead>
          <tr style="background: #112E51; color: #FFFFFF;">
            <th style="padding: 6px; width: 6%; text-align: center;">SEQ</th>
            <th style="padding: 6px; width: 16%; text-align: left;">FECHA / HORA</th>
            <th style="padding: 6px; width: 22%; text-align: left;">ACCIÓN</th>
            <th style="padding: 6px; width: 18%; text-align: left;">PERITO</th>
            <th style="padding: 6px; width: 38%; text-align: left;">HASH SHA-256</th>
          </tr>
        </thead>
        <tbody id="audit-table-body">
          {DEFAULT_LOGS.map((l) => (
            <tr style="border-bottom: 1px solid #CBD5E1;">
              <td style="padding: 5px; text-align: center; font-weight: 700;">{l.seq}</td>
              <td style="padding: 5px;" class="font-mono">{l.ts}</td>
              <td style="padding: 5px; font-weight: 700; color: #005EA2;">{l.accion}</td>
              <td style="padding: 5px;">{l.usuario}</td>
              <td style="padding: 5px; color: #008837;" class="font-mono">{l.hash}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- CERTIFICACIÓN DE INMUTABILIDAD -->
    <div class="section">
      <div class="section-title">2.0 CERTIFICACIÓN DE INMUTABILIDAD Y NO REPUDIO</div>
      <div style="padding: 8px 12px; background: #F8FAFC; border-left: 4px solid #005EA2; border-radius: 4px; font-size: 8pt; line-height: 1.5; color: #1B2A4A;">
        Se certifica que cada acción registrada en este expediente generó un hash criptográfico SHA-256 matemáticamente dependiente del evento anterior, garantizando que ninguna etapa pudo haber sido modificada, insertada o suprimida a posteriori sin romper la integridad probatoria.
      </div>
    </div>

    <!-- FIRMAS -->
    <div class="signature-section" style="padding-top: 10px;">
      <div class="sig-detail-card">
        <div class="sig-detail-label">PERITO AUDITOR</div>
        <div class="sig-field" style="margin-top: 8px;">Nombre: <span class="sig-underline" contenteditable="true" data-field="peritoLider">{caso.peritoLider || 'Perito Principal'}</span></div>
        <div class="sig-field">C.I. N°: <span class="sig-underline" contenteditable="true" data-field="perito_cedula">{caso.perito_cedula || 'V-18.999.001'}</span></div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma del Perito Auditor</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR DER.</span></div>
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR IZQ.</span></div>
        </div>
      </div>

      <div class="sig-detail-card">
        <div class="sig-detail-label">OFICIAL DE CUMPLIMIENTO</div>
        <div class="sig-field" style="margin-top: 8px;">Nombre: <span class="sig-underline" contenteditable="true">Compliance Officer SHA256.US</span></div>
        <div class="sig-field">C.I. N°: <span class="sig-underline" contenteditable="true">V-20.111.222</span></div>
        <div class="sig-line"></div>
        <div class="sig-line-label">Firma del Oficial de Cumplimiento</div>
        <div class="fingerprint-row">
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR DER.</span></div>
          <div class="thumb-wrapper"><div class="thumb-box"></div><span class="thumb-label">PULGAR IZQ.</span></div>
        </div>
      </div>
    </div>
  </PlanillaFolioWrapper>
</div>
