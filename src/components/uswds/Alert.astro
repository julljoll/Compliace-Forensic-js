---
/**
 * SHA256.US — USWDS Alert Component
 * Variantes: info, warning, success, error.
 */
interface Props {
  type?: 'info' | 'warning' | 'success' | 'error';
  heading?: string;
  slim?: boolean;
  noIcon?: boolean;
}

const { type = 'info', heading, slim = false, noIcon = false } = Astro.props;
const typeClass = `usa-alert--${type}`;
const slimClass = slim ? 'usa-alert--slim' : '';
const noIconClass = noIcon ? 'usa-alert--no-icon' : '';
---

<div class={`usa-alert ${typeClass} ${slimClass} ${noIconClass}`} role={type === 'error' ? 'alert' : 'status'}>
  <div class="usa-alert__body">
    {heading && <h4 class="usa-alert__heading">{heading}</h4>}
    <div class="usa-alert__text">
      <slot />
    </div>
  </div>
</div>
